{
  "name": "nullsec",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NullSec: a CTF-focused, privacy-first browser based on Mullvad Browser",
  "license": "MPL-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "predev": "node scripts/generate-icons.mjs",
    "dev": "node scripts/build.mjs --watch",
    "prebuild": "node scripts/generate-icons.mjs",
    "build": "node scripts/build.mjs",
    "prepackage": "node scripts/generate-icons.mjs",
    "package": "node scripts/build.mjs --minify",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "ctf",
    "browser",
    "firefox",
    "mullvad",
    "security"
  ],
  "author": "NullSec contributors",
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "dompurify": "^3.4.18",
    "idb": "^8.0.4",
    "lucide-preact": "^1.76.0",
    "marked": "^18.2.1",
    "preact": "^11.2.0",
    "tldts": "^7.5.5",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/webextension-polyfill": "^0.12.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
