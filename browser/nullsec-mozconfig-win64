ac_add_options --enable-application=browser
ac_add_options --with-base-browser-version=16.0.2
ac_add_options --with-branding=browser/branding/mb-release
ac_add_options --with-app-name=nullsec
ac_add_options --with-app-basename=NullSec
ac_add_options --with-relative-data-dir=../Data
ac_add_options --enable-release
ac_add_options --enable-optimize
ac_add_options --disable-debug
ac_add_options --disable-tests
ac_add_options --disable-debug-symbols
ac_add_options --disable-updater
ac_add_options --disable-lto
ac_add_options --disable-crashreporter
ac_add_options --disable-nodejs
ac_add_options --disable-bootstrap

ac_add_options --without-wasm-sandboxed-libraries

ac_add_options --target=x86_64-pc-windows-gnu
ac_add_options --with-toolchain-prefix=x86_64-w64-mingw32-
ac_add_options --disable-warnings-as-errors
ac_add_options --with-libclang-path=$HOME/clang/lib

ac_add_options --disable-webrtc
ac_add_options --disable-geckodriver
ac_add_options --disable-update-agent
ac_add_options --disable-default-browser-agent
ac_add_options --disable-notification-server

export HOST_CC=$HOME/clang/bin/clang
export HOST_CXX=$HOME/clang/bin/clang++
export CC=x86_64-w64-mingw32-clang
export CXX=x86_64-w64-mingw32-clang++
export AR=llvm-ar
export RANLIB=llvm-ranlib
export CFLAGS="-fms-extensions -include _mingw.h -Wno-error=incompatible-pointer-types"
export CXXFLAGS="-fms-extensions -include _mingw.h"


mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-nullsec-win64
mk_add_options MOZ_MAKE_FLAGS="-j4"
mk_add_options MOZ_PARALLEL_BUILD=4
