+function selectModel(id) {
+  const entry = NullSecModels.findModel(id);
+  if (!entry) {
+    return;
+  }
+  Services.prefs.setStringPref(PREF.modelId, id);
+  Services.prefs.setStringPref(PREF.provider, entry.providerId);
+  if (entry.baseurl) {
+    Services.prefs.setStringPref(PREF.baseurl, entry.baseurl);
+  }
+  Services.prefs.setStringPref(PREF.model, entry.modelId);
+  renderModelPill();
+  closePopovers();
+  loadSettingsIntoUI();
+  updateWelcome();
+}
+
+function renderModelMenu(filter = "") {
+  const list = dom.modelMenuList;
+  list.replaceChildren();
+  const disabled = getDisabledSet();
+  const current = currentModelId();
+  const query = filter.trim().toLowerCase();
+  const groups = [];
+  const byProvider = new Map();
+  for (const model of NullSecModels.allModels()) {
+    if (disabled.has(model.id)) {
+      continue;
+    }
+    if (
+      query &&
+      !`${model.providerName} ${model.modelName}`.toLowerCase().includes(query)
+    ) {
+      continue;
+    }
+    let group = byProvider.get(model.providerId);
+    if (!group) {
+      group = { name: model.providerName, items: [] };
+      byProvider.set(model.providerId, group);
+      groups.push(group);
+    }
+    group.items.push(model);
+  }
+  if (!groups.length) {
+    const empty = document.createElement("div");
+    empty.className = "popover-empty";
+    empty.textContent = "No models. Add one in Manage models.";
+    list.appendChild(empty);
+    return;
+  }
+  for (const group of groups) {
+    const label = document.createElement("div");
+    label.className = "popover-group-label";
+    label.textContent = group.name;
+    list.appendChild(label);
+    for (const model of group.items) {
+      const row = document.createElement("button");
+      row.type = "button";
+      row.className = "popover-row";
+      if (model.id === current) {
+        row.classList.add("is-selected");
+      }
+      const name = document.createElement("span");
+      name.className = "popover-row-name";
+      name.textContent = model.modelName;
+      row.appendChild(name);
+      if (model.local) {
+        const tag = document.createElement("span");
+        tag.className = "popover-tag";
+        tag.textContent = "Local";
+        row.appendChild(tag);
+      }
+      row.appendChild(svgIcon("check", "ns-svg popover-row-check"));
+      row.addEventListener("click", () => selectModel(model.id));
+      list.appendChild(row);
+    }
+  }
+}
