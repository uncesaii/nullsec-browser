+async function runAgent(text) {
+  const cfg = getProviderConfig();
+  const key = getKey(cfg.provider);
+  if (!key && cfg.provider !== "compatible") {
+    showSettings(true);
+    dom.status.textContent = "Add an API key for this provider.";
+    return;
+  }
+  showSettings(false);
+  state.session.objectives.push(text.trim());
+
+  state.messages.push({ role: "user", content: text.trim() });
+  addUserMessage(text.trim());
+  dom.input.value = "";
+  autoGrowInput();
+
+  const assistant = { role: "assistant", content: "" };
+  const view = createAssistantView({ withReasoning: true });
+  view.status.hidden = true;
+  const started = performance.now();
+  let recordedSteps = 0;
+  state.abortController = new AbortController();
+  const signal = state.abortController.signal;
+  setStreaming(true);
+  const system = buildSystemPrompt(true);
+
+  try {
+    const history = state.messages.slice(-24);
+    const initialPage = await collectPageContext();
+    if (initialPage) {
+      const step = {
+        n: 0,
+        thought: "Initial reconnaissance of the active page.",
+        action: { type: "read" },
+        result: { ok: true },
+        url: initialPage.url,
+        title: initialPage.title,
+      };
+      state.session.steps.push(step);
+      appendReasoningStep(view, step);
+      recordedSteps++;
+    }
+    let observation = null;
+    let finished = false;
+    for (let step = 1; step <= MAX_STEPS && !finished; step++) {
+      const messages = observation
+        ? [...history, { role: "user", content: observation }]
+        : history;
+      const raw = await completeChat({ cfg, key, messages, signal, system });
+      const parsed = extractJson(raw);
+      if (!parsed || !parsed.action || parsed.action.type === "done") {
+        assistant.content = parsed?.answer || raw;
+        finished = true;
+        break;
+      }
+      const stepRecord = {
+        n: step,
+        thought: parsed.thought || "",
+        action: parsed.action,
+        result: null,
+        url: "",
+        title: "",
+      };
+      appendReasoningStep(view, stepRecord);
+      const result = await executeAction(parsed.action);
+      await sleep(900);
+      const page = await collectPageContext();
+      stepRecord.result = result;
+      stepRecord.url = page?.url || "";
+      stepRecord.title = page?.title || "";
+      state.session.steps.push(stepRecord);
+      recordedSteps++;
+      if (page?.text) {
+        captureFlags(page.text, page.url);
+      }
+      observation = [
+        `[Observation after step ${step}]`,
+        `Action: ${JSON.stringify(parsed.action)}`,
+        `Result: ${JSON.stringify(result)}`,
+        page
+          ? `URL: ${page.url}\nTITLE: ${page.title}\n\nTEXT:\n${page.text}\n\nCONTROLS:\n${JSON.stringify(page.controls)}`
+          : "No page context available.",
+      ].join("\n");
+      history.push({ role: "assistant", content: raw });
+    }
+    if (!assistant.content) {
+      assistant.content = finished
+        ? "Done."
+        : "_Stopped after reaching the step limit._";
+    }
+    assistant.content = cleanAssistantText(assistant.content) || "Task complete.";
+    captureFlags(assistant.content, getActiveTabInfo().url);
+    view.body.innerHTML = renderMarkdown(assistant.content);
+    view.timing = formatTiming(performance.now() - started);
+    finalizeReasoning(view, performance.now() - started, recordedSteps);
+    attachAssistantActions(view, { text: assistant.content });
+  } catch (error) {
+    if (error.name === "AbortError") {
+      assistant.content = "_[stopped]_";
+    } else {
+      assistant.content = `**Error:** ${error.message}`;
+    }
+    view.body.innerHTML = renderMarkdown(assistant.content);
+    view.timing = formatTiming(performance.now() - started);
+    finalizeReasoning(
+      view,
+      performance.now() - started,
+      recordedSteps,
+      true
+    );
+    attachAssistantActions(view, {
+      text: assistant.content,
+      allowRegenerate: false,
+    });
+  } finally {
+    state.messages.push(assistant);
+    setStreaming(false);
+    state.abortController = null;
+    state.session.lastAnswer = assistant.content;
+    scheduleReport();
+    scrollChat();
+  }
+}
