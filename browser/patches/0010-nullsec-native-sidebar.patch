+    );
+    window.addEventListener(
+      "unload",
+      () => {
+        win.gBrowser.tabContainer.removeEventListener(
+          "TabSelect",
+          updateContext
+        );
+        win.gBrowser.tabContainer.removeEventListener(
+          "TabAttrModified",
+          updateContext
+        );
+      },
+      { once: true }
+    );
+  }
+  const contextTimer = setInterval(updateContext, 1500);
+  window.addEventListener(
+    "unload",
+    () => clearInterval(contextTimer),
+    { once: true }
+  );
+}
+
+async function init() {
+  initChrome();
+  loadSettingsIntoUI();
+  updateContext();
+  const unsubscribeReports = NullSecStore.subscribe(type => {
+    if (type === "flags") {
+      scheduleReport();
+    }
+  });
+  window.addEventListener("unload", unsubscribeReports, { once: true });
+  try {
+    await refreshKeys();
+  } catch (error) {
+    console.error("NullSec: key refresh failed", error);
+  }
+  loadSettingsIntoUI();
+}
+
+init();
