diff --git a/browser/components/nullsec/sidebar.css b/browser/components/nullsec/sidebar.css
new file mode 100644
index 00000000..12db9bd5
--- /dev/null
+++ b/browser/components/nullsec/sidebar.css
@@ -0,0 +1,744 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+:root {
+  color-scheme: dark light;
+  --ns-bg: #1c1b22;
+  --ns-bg-raised: #23222b;
+  --ns-bg-sunken: #17161d;
+  --ns-bg-hover: #2b2a33;
+  --ns-border: #3a3944;
+  --ns-text: #fbfbfe;
+  --ns-muted: #b0b0bd;
+  --ns-faint: #8a8a96;
+  --ns-accent: #41f1b6;
+  --ns-accent-strong: #2bd9a1;
+  --ns-accent-text: #06231a;
+  --ns-danger: #ff6b7a;
+  --ns-warn: #ffd166;
+  --ns-code-bg: #101016;
+  --ns-radius: 10px;
+  --ns-radius-sm: 7px;
+  --ns-font: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+  --ns-mono: ui-monospace, "Cascadia Code", "SF Mono", Consolas, monospace;
+}
+
+@media (prefers-color-scheme: light) {
+  :root {
+    --ns-bg: #f7f7fa;
+    --ns-bg-raised: #ffffff;
+    --ns-bg-sunken: #ededf2;
+    --ns-bg-hover: #e7e7ee;
+    --ns-border: #d7d7e0;
+    --ns-text: #15141a;
+    --ns-muted: #5b5b66;
+    --ns-faint: #77777f;
+    --ns-accent: #0f9d74;
+    --ns-accent-strong: #0b7f5e;
+    --ns-accent-text: #ffffff;
+    --ns-danger: #c62839;
+    --ns-warn: #a15c00;
+    --ns-code-bg: #f0f0f5;
+  }
+}
+
+html,
+body {
+  height: 100%;
+}
+
+body {
+  margin: 0;
+  background: var(--ns-bg);
+  color: var(--ns-text);
+  font-family: var(--ns-font);
+  font-size: 13px;
+  line-height: 1.45;
+  overflow: hidden;
+}
+
+#app {
+  display: flex;
+  flex-direction: column;
+  height: 100vh;
+  min-height: 0;
+}
+
+button,
+input,
+select,
+textarea {
+  font: inherit;
+  color: inherit;
+}
+
+button {
+  cursor: pointer;
+}
+
+/* Header */
+.ns-header {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 10px 12px 8px;
+  border-bottom: 1px solid var(--ns-border);
+  background: var(--ns-bg);
+}
+
+.ns-brand {
+  display: flex;
+  align-items: center;
+  gap: 9px;
+  min-width: 0;
+}
+
+.ns-logo {
+  width: 22px;
+  height: 22px;
+  color: var(--ns-accent);
+  fill: var(--ns-accent);
+  flex: none;
+}
+
+.ns-brand-text {
+  display: flex;
+  flex-direction: column;
+  min-width: 0;
+  line-height: 1.15;
+}
+
+.ns-name {
+  font-weight: 700;
+  font-size: 14px;
+  letter-spacing: 0.2px;
+}
+
+.ns-sub {
+  color: var(--ns-muted);
+  font-size: 11px;
+}
+
+.ns-header .ns-icon-btn {
+  margin-inline-start: auto;
+}
+
+.ns-icon-btn {
+  width: 26px;
+  height: 26px;
+  display: inline-grid;
+  place-items: center;
+  border: 0;
+  border-radius: var(--ns-radius-sm);
+  background: transparent;
+  color: var(--ns-muted);
+}
+
+.ns-icon-btn:hover {
+  background: var(--ns-bg-hover);
+  color: var(--ns-text);
+}
+
+/* Tabs */
+.ns-tabs {
+  display: flex;
+  gap: 2px;
+  padding: 6px 8px;
+  border-bottom: 1px solid var(--ns-border);
+  background: var(--ns-bg);
+  overflow-x: auto;
+  scrollbar-width: none;
+}
+
+.ns-tab {
+  border: 0;
+  background: transparent;
+  color: var(--ns-muted);
+  padding: 5px 9px;
+  border-radius: 999px;
+  white-space: nowrap;
+  font-weight: 600;
+  font-size: 12px;
+}
+
+.ns-tab:hover {
+  background: var(--ns-bg-hover);
+  color: var(--ns-text);
+}
+
+.ns-tab.is-active {
+  background: color-mix(in srgb, var(--ns-accent) 18%, transparent);
+  color: var(--ns-accent);
+}
+
+.ns-pill {
+  display: inline-block;
+  min-width: 16px;
+  padding: 0 5px;
+  margin-inline-start: 3px;
+  border-radius: 999px;
+  background: color-mix(in srgb, var(--ns-text) 10%, transparent);
+  color: inherit;
+  font-size: 10px;
+  line-height: 16px;
+  text-align: center;
+}
+
+/* Panels */
+.ns-main {
+  position: relative;
+  flex: 1;
+  min-height: 0;
+  display: flex;
+}
+
+.ns-panel {
+  display: none;
+  flex-direction: column;
+  flex: 1;
+  min-height: 0;
+  min-width: 0;
+  padding: 10px 10px 12px;
+  overflow: hidden;
+}
+
+.ns-panel.is-active {
+  display: flex;
+}
+
+/* Shared controls */
+.ns-row {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+}
+
+.ns-spacer {
+  flex: 1;
+}
+
+.ns-muted {
+  color: var(--ns-muted);
+  font-size: 11px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.ns-input,
+.ns-select {
+  width: 100%;
+  box-sizing: border-box;
+  border: 1px solid var(--ns-border);
+  border-radius: var(--ns-radius-sm);
+  background: var(--ns-bg-sunken);
+  color: var(--ns-text);
+  padding: 6px 8px;
+  outline: none;
+}
+
+.ns-input:focus,
+.ns-select:focus,
+.ns-notes:focus,
+#chat-input:focus {
+  border-color: var(--ns-accent);
+  box-shadow: 0 0 0 2px color-mix(in srgb, var(--ns-accent) 25%, transparent);
+}
+
+.ns-input::placeholder,
+.ns-notes::placeholder,
+#chat-input::placeholder {
+  color: var(--ns-faint);
+}
+
+.ns-btn {
+  border: 1px solid transparent;
+  border-radius: var(--ns-radius-sm);
+  padding: 6px 10px;
+  font-weight: 600;
+  font-size: 12px;
+  white-space: nowrap;
+}
+
+.ns-btn-primary {
+  background: var(--ns-accent);
+  color: var(--ns-accent-text);
+}
+
+.ns-btn-primary:hover {
+  background: var(--ns-accent-strong);
+}
+
+.ns-btn-ghost {
+  background: transparent;
+  border-color: var(--ns-border);
+  color: var(--ns-text);
+}
+
+.ns-btn-ghost:hover {
+  background: var(--ns-bg-hover);
+}
+
+.ns-mini-btn {
+  border: 0;
+  background: transparent;
+  color: var(--ns-muted);
+  font-size: 11px;
+  padding: 3px 5px;
+  border-radius: 5px;
+}
+
+.ns-mini-btn:hover {
+  background: var(--ns-bg-hover);
+  color: var(--ns-text);
+}
+
+.ns-dot {
+  width: 7px;
+  height: 7px;
+  border-radius: 50%;
+  background: var(--ns-accent);
+  box-shadow: 0 0 0 3px color-mix(in srgb, var(--ns-accent) 16%, transparent);
+  flex: none;
+}
+
+.ns-dot.is-paused {
+  background: var(--ns-faint);
+  box-shadow: none;
+}
+
+/* Context strip */
+.ns-context {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 6px 8px;
+  margin-bottom: 8px;
+  border: 1px solid var(--ns-border);
+  border-radius: var(--ns-radius-sm);
+  background: var(--ns-bg-raised);
+}
+
+.ns-context-text {
+  font-size: 11px;
+  color: var(--ns-muted);
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  direction: rtl;
+  text-align: left;
+}
+
+/* Chat */
+.ns-chat {
+  flex: 1;
+  min-height: 0;
+  overflow-y: auto;
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+  padding: 2px 2px 8px;
+}
+
+.ns-empty {
+  margin: auto;
+  max-width: 320px;
+  text-align: center;
+  padding: 24px 10px;
+}
+
+.ns-empty-title {
+  font-size: 16px;
+  font-weight: 700;
+  margin-bottom: 4px;
+}
+
+.ns-empty-sub {
+  color: var(--ns-muted);
+  font-size: 12px;
+  margin-bottom: 14px;
+}
+
+.ns-chips {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  gap: 6px;
+}
+
+.ns-chip {
+  border: 1px solid var(--ns-border);
+  background: var(--ns-bg-raised);
+  color: var(--ns-text);
+  border-radius: 999px;
+  padding: 5px 10px;
+  font-size: 11px;
+}
+
+.ns-chip:hover {
+  border-color: var(--ns-accent);
+  color: var(--ns-accent);
+}
+
+.ns-msg {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  max-width: 100%;
+}
+
+.ns-msg-role {
+  font-size: 10px;
+  font-weight: 700;
+  letter-spacing: 0.6px;
+  text-transform: uppercase;
+  color: var(--ns-faint);
+}
+
+.ns-msg-body {
+  border: 1px solid var(--ns-border);
+  border-radius: var(--ns-radius);
+  padding: 8px 10px;
+  background: var(--ns-bg-raised);
+  white-space: pre-wrap;
+  overflow-wrap: anywhere;
+}
+
+.ns-msg.is-user .ns-msg-body {
+  background: color-mix(in srgb, var(--ns-accent) 12%, var(--ns-bg-raised));
+  border-color: color-mix(in srgb, var(--ns-accent) 30%, var(--ns-border));
+}
+
+.ns-msg-body code {
+  font-family: var(--ns-mono);
+  font-size: 11.5px;
+  background: var(--ns-code-bg);
+  border-radius: 4px;
+  padding: 1px 4px;
+}
+
+.ns-msg-body pre {
+  margin: 6px 0;
+  padding: 8px;
+  border-radius: 7px;
+  background: var(--ns-code-bg);
+  overflow-x: auto;
+}
+
+.ns-msg-body pre code {
+  padding: 0;
+  background: none;
+}
+
+/* Composer */
+.ns-composer {
+  border-top: 1px solid var(--ns-border);
+  padding-top: 8px;
+}
+
+#chat-input {
+  width: 100%;
+  box-sizing: border-box;
+  resize: vertical;
+  min-height: 42px;
+  max-height: 160px;
+  border: 1px solid var(--ns-border);
+  border-radius: var(--ns-radius);
+  background: var(--ns-bg-sunken);
+  color: var(--ns-text);
+  padding: 8px 9px;
+  outline: none;
+}
+
+.ns-composer-row {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  margin-top: 6px;
+}
+
+/* Settings */
+.ns-settings {
+  border: 1px solid var(--ns-border);
+  border-radius: var(--ns-radius);
+  background: var(--ns-bg-raised);
+  padding: 10px;
+  margin-top: 8px;
+  max-height: 55vh;
+  overflow-y: auto;
+}
+
+.ns-field {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  margin-bottom: 8px;
+  font-size: 11px;
+  color: var(--ns-muted);
+}
+
+.ns-field-inline {
+  flex-direction: row;
+  align-items: center;
+  gap: 8px;
+  margin: 0;
+}
+
+.ns-field-inline .ns-select {
+  width: auto;
+  min-width: 140px;
+}
+
+/* Traffic */
+.ns-toolbar {
+  display: grid;
+  grid-template-columns: 1fr auto auto auto;
+  gap: 6px;
+  margin-bottom: 6px;
+}
+
+.ns-traffic-status {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  margin-bottom: 6px;
+}
+
+.ns-traffic-list {
+  flex: 1;
+  min-height: 0;
+  overflow-y: auto;
+  border: 1px solid var(--ns-border);
+  border-radius: var(--ns-radius);
+  background: var(--ns-bg-sunken);
+}
+
+.ns-req {
+  display: grid;
+  grid-template-columns: 54px 1fr auto;
+  gap: 4px 8px;
+  align-items: center;
+  padding: 7px 8px;
+  border-bottom: 1px solid var(--ns-border);
+  cursor: pointer;
+}
+
+.ns-req:last-child {
+  border-bottom: 0;
+}
+
+.ns-req:hover,
+.ns-req.is-selected {
+  background: var(--ns-bg-hover);
+}
+
+.ns-method {
+  font-family: var(--ns-mono);
+  font-size: 10px;
+  font-weight: 700;
+  color: var(--ns-accent);
+}
+
+.ns-method.is-post,
+.ns-method.is-put,
+.ns-method.is-patch {
+  color: var(--ns-warn);
+}
+
+.ns-method.is-delete {
+  color: var(--ns-danger);
+}
+
+.ns-req-host {
+  font-weight: 600;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.ns-req-path {
+  grid-column: 2;
+  color: var(--ns-muted);
+  font-family: var(--ns-mono);
+  font-size: 10.5px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.ns-req-status {
+  font-family: var(--ns-mono);
+  font-size: 10.5px;
+  font-weight: 700;
+  color: var(--ns-muted);
+  text-align: right;
+}
+
+.ns-req-status.is-ok {
+  color: var(--ns-accent);
+}
+
+.ns-req-status.is-redirect {
+  color: var(--ns-warn);
+}
+
+.ns-req-status.is-error {
+  color: var(--ns-danger);
+}
+
+.ns-traffic-detail {
+  margin-top: 8px;
+  border: 1px solid var(--ns-border);
+  border-radius: var(--ns-radius);
+  background: var(--ns-bg-raised);
+  padding: 9px;
+  max-height: 42vh;
+  overflow-y: auto;
+}
+
+.ns-detail-title {
+  font-family: var(--ns-mono);
+  font-size: 11px;
+  overflow-wrap: anywhere;
+  margin-bottom: 6px;
+}
+
+.ns-headers {
+  font-family: var(--ns-mono);
+  font-size: 10.5px;
+  color: var(--ns-muted);
+  white-space: pre-wrap;
+  overflow-wrap: anywhere;
+  margin: 6px 0;
+}
+
+.ns-detail-actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+  margin-top: 8px;
+}
+
+.ns-detail-output {
+  margin-top: 8px;
+  font-family: var(--ns-mono);
+  font-size: 10.5px;
+  white-space: pre-wrap;
+  overflow-wrap: anywhere;
+  background: var(--ns-code-bg);
+  border-radius: 7px;
+  padding: 8px;
+  max-height: 180px;
+  overflow-y: auto;
+}
+
+/* Notes */
+.ns-notes-head {
+  margin-bottom: 6px;
+}
+
+.ns-notes {
+  flex: 1;
+  min-height: 0;
+  resize: none;
+  width: 100%;
+  box-sizing: border-box;
+  border: 1px solid var(--ns-border);
+  border-radius: var(--ns-radius);
+  background: var(--ns-bg-sunken);
+  color: var(--ns-text);
+  padding: 10px;
+  font-family: var(--ns-mono);
+  font-size: 12px;
+  line-height: 1.55;
+  outline: none;
+}
+
+/* Targets */
+.ns-form {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  margin-bottom: 8px;
+}
+
+.ns-flag-row {
+  margin-bottom: 8px;
+}
+
+.ns-flag-row .ns-select {
+  width: auto;
+  max-width: 42%;
+}
+
+.ns-targets {
+  flex: 1;
+  min-height: 0;
+  overflow-y: auto;
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+
+.ns-target {
+  border: 1px solid var(--ns-border);
+  border-radius: var(--ns-radius);
+  background: var(--ns-bg-raised);
+  padding: 9px;
+}
+
+.ns-target-head {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+}
+
+.ns-target-name {
+  font-weight: 700;
+}
+
+.ns-target-scope {
+  color: var(--ns-muted);
+  font-family: var(--ns-mono);
+  font-size: 10.5px;
+  overflow-wrap: anywhere;
+  margin-top: 2px;
+}
+
+.ns-target-flags {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 4px;
+  margin-top: 6px;
+}
+
+.ns-flag {
+  font-family: var(--ns-mono);
+  font-size: 10.5px;
+  background: color-mix(in srgb, var(--ns-accent) 16%, transparent);
+  color: var(--ns-accent);
+  border-radius: 5px;
+  padding: 2px 6px;
+  overflow-wrap: anywhere;
+}
+
+.ns-status {
+  margin-inline-start: auto;
+  font-size: 10px;
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: 0.5px;
+  color: var(--ns-faint);
+}
+
+.ns-status.is-owned {
+  color: var(--ns-accent);
+}
+
+.ns-empty-inline {
+  color: var(--ns-muted);
+  font-size: 12px;
+  text-align: center;
+  padding: 18px 8px;
+}
\ No newline at end of file
diff --git a/browser/components/nullsec/sidebar.html b/browser/components/nullsec/sidebar.html
new file mode 100644
index 00000000..f54fbbb3
