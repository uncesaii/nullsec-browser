+function curlFor(entry) {
+  const parts = [`curl -i -X ${entry.method} '${entry.url}'`];
+  for (const [name, value] of Object.entries(entry.reqHeaders || {})) {
+    const lower = name.toLowerCase();
+    if (["host", "content-length", "connection", "accept-encoding"].includes(lower)) {
+      continue;
+    }
+    parts.push(`  -H '${name}: ${String(value).replaceAll("'", "'\\''")}'`);
+  }
+  return parts.join(" \\\n");
+}
