+async function setKey(provider, key) {
+  const store = keyStore();
+  const prefName = KEY_PREF_PREFIX + provider;
+  const label = KEY_LABEL_PREFIX + provider;
+  try {
+    if (!key) {
+      Services.prefs.clearUserPref(prefName);
+      await store.asyncDeleteSecret(label);
+      keyCache.delete(provider);
+      return true;
+    }
+    if (!(await store.asyncSecretAvailable(label))) {
