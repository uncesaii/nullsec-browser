diff --git a/browser/components/nullsec/traffic.mjs b/browser/components/nullsec/traffic.mjs
new file mode 100644
index 00000000..becab2a3
--- /dev/null
+++ b/browser/components/nullsec/traffic.mjs
@@ -0,0 +1,258 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+const NullSecStore = ChromeUtils.importESModule(
+  "moz-src:///browser/components/nullsec/NullSecStore.sys.mjs"
+);
+
+const state = {
+  filter: "",
+  selectedId: null,
+};
+
+const dom = {};
+
+function $(id) {
+  return document.getElementById(id);
+}
+
+function formatBytes(value) {
+  if (!Number.isFinite(value) || value < 0) {
+    return "";
+  }
+  if (value < 1024) {
+    return `${value} B`;
+  }
+  if (value < 1024 * 1024) {
+    return `${(value / 1024).toFixed(1)} KB`;
+  }
+  return `${(value / (1024 * 1024)).toFixed(1)} MB`;
+}
+
+function splitUrl(url) {
+  try {
+    const parsed = new URL(url);
+    return {
+      host: parsed.host,
+      path: `${parsed.pathname}${parsed.search}`,
+    };
+  } catch {
+    return { host: url, path: "" };
+  }
+}
+
+function copyText(text) {
+  const helper = Cc["@mozilla.org/widget/clipboardhelper;1"].getService(
+    Ci.nsIClipboardHelper
+  );
+  helper.copyString(text);
+}
+
+function curlFor(entry) {
+  const parts = [`curl -i -X ${entry.method} '${entry.url}'`];
+  for (const [name, value] of Object.entries(entry.reqHeaders || {})) {
+    const lower = name.toLowerCase();
+    if (
+      ["host", "content-length", "connection", "accept-encoding"].includes(
+        lower
+      )
+    ) {
+      continue;
+    }
+    parts.push(`  -H '${name}: ${String(value).replaceAll("'", "'\\''")}'`);
+  }
+  return parts.join(" \\\n");
+}
+
+function filteredTraffic() {
+  const filter = state.filter.trim().toLowerCase();
+  return NullSecStore.getTraffic().filter(entry => {
+    if (!filter) {
+      return true;
+    }
+    return `${entry.method} ${entry.url} ${entry.status}`
+      .toLowerCase()
+      .includes(filter);
+  });
+}
+
+function renderDetail(entry) {
+  dom.detail.hidden = false;
+  dom.detail.replaceChildren();
+
+  const card = document.createElement("div");
+  card.className = "traffic-detail";
+
+  const title = document.createElement("h3");
+  title.textContent = `${entry.method} ${entry.url}`;
+  card.appendChild(title);
+
+  const meta = document.createElement("div");
+  meta.className = "meta";
+  const type = entry.type || "unknown";
+  const size = formatBytes(entry.size);
+  meta.textContent = `${entry.status} ${entry.statusText || ""} - ${type}${size ? ` - ${size}` : ""}`;
+  card.appendChild(meta);
+
+  const actions = document.createElement("div");
+  actions.className = "actions";
+
+  const copy = document.createElement("moz-button");
+  copy.setAttribute("type", "ghost");
+  copy.textContent = "Copy as cURL";
+  copy.addEventListener("click", () => {
+    copyText(curlFor(entry));
+    copy.textContent = "Copied";
+    setTimeout(() => (copy.textContent = "Copy as cURL"), 1200);
+  });
+
+  const close = document.createElement("moz-button");
+  close.setAttribute("type", "ghost");
+  close.textContent = "Close";
+  close.addEventListener("click", () => {
+    state.selectedId = null;
+    dom.detail.hidden = true;
+    dom.detail.replaceChildren();
+    renderList();
+  });
+
+  actions.append(copy, close);
+  card.appendChild(actions);
+
+  const requestHeading = document.createElement("h4");
+  requestHeading.textContent = "Request headers";
+  const requestHeaders = document.createElement("pre");
+  requestHeaders.textContent =
+    Object.entries(entry.reqHeaders || {})
+      .map(([name, value]) => `${name}: ${value}`)
+      .join("\n") || "(none captured)";
+  card.append(requestHeading, requestHeaders);
+
+  const responseHeading = document.createElement("h4");
+  responseHeading.textContent = "Response headers";
+  const responseHeaders = document.createElement("pre");
+  responseHeaders.textContent =
+    Object.entries(entry.headers || {})
+      .map(([name, value]) => `${name}: ${value}`)
+      .join("\n") || "(none captured)";
+  card.append(responseHeading, responseHeaders);
+  dom.detail.appendChild(card);
+  dom.detail.scrollIntoView({ block: "nearest" });
+}
+
+function renderList() {
+  const entries = filteredTraffic();
+  dom.list.replaceChildren();
+  if (!entries.length) {
+    const empty = document.createElement("div");
+    empty.className = "empty";
+    empty.textContent = NullSecStore.getTraffic().length
+      ? "No requests match this filter."
+      : "Waiting for HTTP traffic...";
+    dom.list.appendChild(empty);
+    return;
+  }
+  for (const entry of entries.slice(0, 300)) {
+    const { host, path } = splitUrl(entry.url);
+    const row = document.createElement("button");
+    row.type = "button";
+    row.className = "traffic-row";
+    if (entry.id === state.selectedId) {
+      row.classList.add("is-selected");
+    }
+
+    const method = document.createElement("span");
+    method.className = "traffic-method";
+    method.textContent = entry.method;
+
+    const main = document.createElement("span");
+    main.className = "traffic-main";
+    const hostEl = document.createElement("span");
+    hostEl.className = "traffic-host";
+    hostEl.textContent = host;
+    const pathEl = document.createElement("span");
+    pathEl.className = "traffic-path";
+    pathEl.textContent = path || "/";
+    main.append(hostEl, document.createElement("br"), pathEl);
+
+    const status = document.createElement("span");
+    status.className = "traffic-status";
+    if (entry.status >= 400) {
+      status.classList.add("is-error");
+    }
+    status.textContent = entry.status || "";
+
+    row.append(method, main, status);
+    row.addEventListener("click", () => {
+      state.selectedId = entry.id;
+      renderList();
+      renderDetail(entry);
+    });
+    dom.list.appendChild(row);
+  }
+}
+
+let renderQueued = false;
+function scheduleRender() {
+  if (renderQueued) {
+    return;
+  }
+  renderQueued = true;
+  requestAnimationFrame(() => {
+    renderQueued = false;
+    renderList();
+  });
+}
+
+function updatePause() {
+  const paused = NullSecStore.isPaused();
+  dom.pause.textContent = paused ? "Resume" : "Pause";
+  dom.pause.title = paused ? "Resume capture" : "Pause capture";
+}
+
+function init() {
+  dom.filter = $("traffic-filter");
+  dom.pause = $("traffic-pause");
+  dom.clear = $("traffic-clear");
+  dom.list = $("traffic-list");
+  dom.detail = $("traffic-detail");
+
+  dom.filter.addEventListener("input", () => {
+    state.filter = dom.filter.value;
+    scheduleRender();
+  });
+  dom.filter.addEventListener("MozInputSearch:search", event => {
+    state.filter = event.detail?.query || "";
+    scheduleRender();
+  });
+  dom.pause.addEventListener("click", () => {
+    NullSecStore.setPaused(!NullSecStore.isPaused());
+  });
+  dom.clear.addEventListener("click", () => {
+    NullSecStore.clearTraffic();
+    state.selectedId = null;
+    dom.detail.hidden = true;
+    dom.detail.replaceChildren();
+    scheduleRender();
+  });
+
+  const unsubscribe = NullSecStore.subscribe(type => {
+    if (type === "traffic") {
+      scheduleRender();
+    } else if (type === "clear") {
+      state.selectedId = null;
+      dom.detail.hidden = true;
+      dom.detail.replaceChildren();
+      scheduleRender();
+    } else if (type === "paused") {
+      updatePause();
+    }
+  });
+  window.addEventListener("unload", unsubscribe, { once: true });
+
+  updatePause();
+  renderList();
+}
+
+init();
