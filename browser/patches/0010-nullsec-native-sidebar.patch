+    needsKey: true,
+    models: [
+      { id: "gpt-4o-mini", name: "GPT-4o mini" },
+      { id: "claude-3-5-sonnet-20241022", name: "Claude 3.5 Sonnet" },
+    ],
+  },
+  {
+    id: "50x",
+    name: "50X",
+    group: "other",
+    api: "openai",
+    baseurl: "",
+    keyLabel: "50X API key",
+    needsKey: true,
+    models: [],
+  },
+];
+
+export function getProvider(id) {
+  return PROVIDERS.find(provider => provider.id === id) || null;
+}
+
+export function getModel(providerId, modelId) {
+  const provider = getProvider(providerId);
+  if (!provider) {
+    return null;
+  }
+  const model = provider.models.find(m => m.id === modelId);
+  return model ? { provider, model } : null;
+}
+
+export function makeId(providerId, modelId) {
+  return `${providerId}/${modelId}`;
+}
+
+export function parseId(id) {
+  const index = String(id || "").indexOf("/");
+  if (index === -1) {
+    return { providerId: id || "", modelId: "" };
+  }
+  return {
+    providerId: id.slice(0, index),
+    modelId: id.slice(index + 1),
+  };
+}
+
+export function findModel(id) {
+  const { providerId, modelId } = parseId(id);
+  const found = getModel(providerId, modelId);
+  if (!found) {
+    return null;
+  }
+  return {
+    id,
+    providerId,
+    providerName: found.provider.name,
+    modelId,
+    modelName: found.model.name,
+    api: found.provider.api,
+    baseurl: found.provider.baseurl,
+    needsKey: found.provider.needsKey !== false,
+    local: !!found.provider.local,
+    keyLabel: found.provider.keyLabel || "API key",
+  };
+}
+
+export function allModels() {
+  const list = [];
+  for (const provider of PROVIDERS) {
+    for (const model of provider.models) {
+      list.push({
+        id: makeId(provider.id, model.id),
+        providerId: provider.id,
+        providerName: provider.name,
+        modelId: model.id,
+        modelName: model.name,
+        api: provider.api,
+        baseurl: provider.baseurl,
+        needsKey: provider.needsKey !== false,
+        local: !!provider.local,
+        keyLabel: provider.keyLabel || "API key",
+      });
+    }
+  }
+  return list;
+}
+
+export function findProviderByBaseurl(baseurl) {
+  if (!baseurl) {
+    return null;
+  }
+  return (
+    PROVIDERS.find(
+      provider =>
+        provider.baseurl &&
+        baseurl.replace(/\/+$/, "") === provider.baseurl.replace(/\/+$/, "")
+    ) || null
+  );
+}
+
+export function defaultModelId() {
+  return makeId("openai", "gpt-4o-mini");
+}
diff --git a/browser/components/nullsec/NullSecStore.sys.mjs b/browser/components/nullsec/NullSecStore.sys.mjs
new file mode 100644
index 00000000..f7370d24
--- /dev/null
+++ b/browser/components/nullsec/NullSecStore.sys.mjs
@@ -0,0 +1,173 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+const MAX_TRAFFIC = 800;
+const TRAFFIC_TOPICS = [
+  "http-on-examine-response",
+  "http-on-examine-cached-response",
+  "http-on-examine-merged-response",
+];
+
+const listeners = new Set();
+const flagValues = new Set();
+
+let traffic = [];
+let flags = [];
+let reports = [];
+let trafficSeq = 0;
+let paused = false;
+let observer = null;
+
+function emit(type, detail) {
+  for (const listener of listeners) {
+    try {
+      listener(type, detail);
+    } catch (error) {
+      console.error("NullSecStore listener failed", error);
+    }
+  }
+}
+
+const trafficObserver = {
+  observe(subject, topic) {
+    if (paused) {
+      return;
+    }
+    let channel;
+    try {
+      channel = subject.QueryInterface(Ci.nsIHttpChannel);
+    } catch {
+      return;
+    }
+    let url = "";
+    try {
+      url = channel.URI?.spec || "";
+    } catch {
+      return;
+    }
+    if (!/^https?:/i.test(url)) {
+      return;
+    }
+    let entry;
+    try {
+      entry = {
+        id: ++trafficSeq,
+        ts: Date.now(),
+        method: channel.requestMethod || "GET",
+        url,
+        status: channel.responseStatus || 0,
+        statusText: channel.responseStatusText || "",
+        type: channel.getResponseHeader("content-type") || "",
+        size: channel.contentLength,
+        reqHeaders: {},
+        headers: {},
+        cached: topic === "http-on-examine-cached-response",
+      };
+      channel.visitRequestHeaders({
+        visitHeader(name, value) {
+          entry.reqHeaders[name] = value;
+        },
+      });
+      channel.visitResponseHeaders({
+        visitHeader(name, value) {
+          entry.headers[name] = value;
+        },
+      });
+    } catch {
+      return;
+    }
+    traffic.unshift(entry);
+    if (traffic.length > MAX_TRAFFIC) {
+      traffic.length = MAX_TRAFFIC;
+    }
+    emit("traffic", entry);
+  },
+};
+
+function ensureObserver() {
+  if (observer) {
+    return;
+  }
+  observer = trafficObserver;
+  for (const topic of TRAFFIC_TOPICS) {
+    Services.obs.addObserver(observer, topic);
+  }
+}
+
+ensureObserver();
+
+export function subscribe(listener) {
+  listeners.add(listener);
+  return () => listeners.delete(listener);
+}
+
+export function getTraffic() {
+  return traffic;
+}
+
+export function clearTraffic() {
+  traffic = [];
+  emit("clear");
+}
+
+export function getFlags() {
+  return flags;
+}
+
+export function addFlag(value, url = "", note = "") {
+  const flag = String(value || "").trim();
+  if (!flag || flagValues.has(flag)) {
+    return null;
+  }
+  flagValues.add(flag);
+  const entry = {
+    id: flagValues.size,
+    value: flag,
+    url,
+    note: String(note || "").trim(),
+    ts: Date.now(),
+  };
+  flags.unshift(entry);
+  emit("flags", entry);
+  return entry;
+}
+
+export function isPaused() {
+  return paused;
+}
+
+export function setPaused(value) {
+  paused = !!value;
+  emit("paused", paused);
+}
+
+export function getReports() {
+  return reports;
+}
+
+export function setReport(report) {
+  if (!report || !report.id) {
+    return;
+  }
+  const index = reports.findIndex(entry => entry.id === report.id);
+  if (index >= 0) {
+    reports[index] = report;
+  } else {
+    reports.unshift(report);
+    if (reports.length > 50) {
+      reports.length = 50;
+    }
+  }
+  emit("reports", report);
+}
+
+export function removeReport(id) {
+  reports = reports.filter(entry => entry.id !== id);
+  emit("reports", null);
+}
+
+export function clearReports() {
+  reports = [];
+  emit("reports", null);
+}
