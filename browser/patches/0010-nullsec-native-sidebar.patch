+  const store = keyStore();
+  for (const provider of Object.keys(PROVIDER_DEFAULTS)) {
+    const encrypted = Services.prefs.getStringPref(
+      KEY_PREF_PREFIX + provider,
+      ""
+    );
+    if (!encrypted) {
+      continue;
+    }
+    try {
+      const bytes = await store.asyncDecryptBytes(
+        KEY_LABEL_PREFIX + provider,
+        encrypted
+      );
+      keyCache.set(provider, new TextDecoder().decode(new Uint8Array(bytes)));
