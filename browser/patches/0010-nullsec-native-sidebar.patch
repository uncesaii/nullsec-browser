+async function sendChat(text) {
+  const trimmed = text.trim();
+  if (!trimmed || state.streaming) {
+    return;
+  }
+  if (wantsReport(trimmed)) {
+    addUserMessage(trimmed);
+    dom.input.value = "";
+    autoGrowInput();
+    const view = createAssistantView();
+    setAssistantStatus(view, null);
+    view.status.hidden = true;
+    view.body.innerHTML = renderMarkdown(
