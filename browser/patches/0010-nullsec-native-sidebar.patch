+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+body {
+  height: 100%;
+  margin: 0;
+}
+
+.options-container {
+  align-items: center;
+  display: flex;
+  gap: var(--space-small);
+  width: 100%;
+}
+
+moz-input-search {
+  flex: 1;
+  min-width: 0;
+}
+
+#traffic-list {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+}
+
+.traffic-row {
+  align-items: center;
+  background: transparent;
+  border: none;
+  border-radius: var(--border-radius-medium);
+  color: var(--text-color);
+  cursor: default;
+  display: grid;
+  font: inherit;
+  gap: var(--space-small);
+  grid-template-columns: auto minmax(0, 1fr) auto;
+  padding: var(--space-small);
+  text-align: start;
+  width: 100%;
+}
+
+.traffic-row:hover {
+  background-color: var(--button-background-color-ghost-hover);
+}
+
+.traffic-row.is-selected {
+  background-color: var(--button-background-color-ghost-hover);
+}
+
+.traffic-method {
+  color: var(--text-color-deemphasized);
+  font-size: 11px;
+  font-weight: var(--font-weight-semibold);
+  min-width: 3.5em;
+}
+
+.traffic-main {
+  min-width: 0;
+}
+
+.traffic-host {
+  font-weight: var(--font-weight-semibold);
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.traffic-path {
+  color: var(--text-color-deemphasized);
+  font-size: 12px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.traffic-status {
