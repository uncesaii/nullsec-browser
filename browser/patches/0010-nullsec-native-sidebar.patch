+const WAIT_PHRASES = [
+  "Thinking",
+  "Investigating",
+  "Analyzing the target",
+  "Finding the best approach",
+  "Reviewing the evidence",
+  "Planning the next step",
+];
+
+function hostOf(url) {
+  try {
+    return new URL(url).host;
+  } catch {
+    return url || "";
+  }
+}
+
+function liveActionLabel(action = {}, page = null) {
+  switch (action.type) {
+    case "search":
+      return `Learning skill: ${action.query || "security knowledge"}`;
+    case "knowledge":
+      return `Reading skill: ${action.id || ""}`;
+    case "read":
+      return page?.title ? `Reading ${page.title}` : "Reading the page";
+    case "click":
+      return `Investigating: ${action.selector || "element"}`;
+    case "type":
+      return `Submitting input into ${action.selector || "form"}`;
+    case "navigate":
+      return `Navigating to ${hostOf(action.url)}`;
+    case "scroll":
+      return "Scrolling the page";
+    case "back":
+      return "Going back";
+    case "forward":
+      return "Going forward";
+    case "flag":
+      return "Capturing the flag";
+    case "report":
+      return "Generating the engagement report";
+    case "answer":
+      return "Composing the answer";
+    default:
+      return describeAction(action);
+  }
+}
+
+function truncate(text, max = 96) {
+  const value = String(text || "").replace(/\s+/g, " ").trim();
+  return value.length > max ? `${value.slice(0, max)}…` : value;
+}
+
+function partialThought(text) {
+  const match = String(text).match(/"thought"\s*:\s*"((?:[^"\\]|\\.)*)"/);
+  if (!match) {
+    return "";
+  }
+  return match[1]
+    .replace(/\\n/g, " ")
+    .replace(/\\t/g, " ")
+    .replace(/\\"/g, '"')
+    .replace(/\\u[0-9a-fA-F]{4}/g, "")
+    .trim();
+}
+
+function partialAnswer(text) {
+  const source = String(text);
+  if (/"action"\s*:/.test(source)) {
+    return "";
+  }
+  const match = source.match(/"answer"\s*:\s*"((?:[^"\\]|\\.)*)/);
+  if (!match) {
+    return "";
+  }
+  return match[1]
+    .replace(/\\n/g, "\n")
+    .replace(/\\"/g, '"')
+    .replace(/\\t/g, "  ");
+}
+
+function startStatusRotation(view, phrases = WAIT_PHRASES) {
+  stopStatusRotation(view);
+  let index = 0;
+  const tick = () => {
+    const target = view.reasoningLabel || view.statusText;
+    if (target) {
+      target.textContent = `${phrases[index % phrases.length]}…`;
+    }
+    index++;
+  };
+  tick();
+  view.statusTimer = setInterval(tick, 1500);
+}
+
+function stopStatusRotation(view) {
+  if (view.statusTimer) {
+    clearInterval(view.statusTimer);
+    view.statusTimer = null;
+  }
+}
+
+function setLiveActivity(view, text) {
+  if (!text) {
+    return;
+  }
+  const label = truncate(text);
+  if (view.reasoningLabel) {
+    view.reasoningLabel.textContent = label;
+  }
+  if (view.currentStep) {
+    view.currentStep.label.textContent = label;
+  }
+}
+
