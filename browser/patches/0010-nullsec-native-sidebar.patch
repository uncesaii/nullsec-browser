+  border-bottom: 1px solid var(--border-color);
+  display: flex;
+  gap: var(--space-small);
+  padding: var(--space-small) var(--space-large);
+}
+
+.settings-title {
+  flex: 1;
+  font-size: 15px;
+  font-weight: var(--font-weight-semibold);
+}
+
+.settings-scroll {
+  display: flex;
+  flex: 1;
+  flex-direction: column;
+  gap: var(--space-medium);
+  min-height: 0;
+  overflow-y: auto;
+  padding: var(--space-large);
+}
+
+.settings-scroll moz-card {
+  margin-block-start: 0;
+}
+
+.settings-fields {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-small);
+}
+
+.settings-fields > * {
+  display: block;
+  width: 100%;
+}
+
+.settings-help {
+  color: var(--text-color-deemphasized);
+  font-size: 12px;
+  margin: 0;
+}
+
+.settings-footer {
