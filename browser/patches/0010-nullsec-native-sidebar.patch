+function beginWalkStep(view, { n, title }) {
+  if (!view.reasoningBody) {
+    return null;
+  }
+  const el = document.createElement("details");
+  el.className = "walk-step";
+  el.dataset.state = "running";
+  const head = document.createElement("summary");
+  head.className = "walk-head";
+  const num = document.createElement("span");
+  num.className = "walk-num";
+  num.textContent = String(n);
+  const icon = document.createElement("span");
+  icon.className = "walk-icon";
+  icon.append(svgIcon("loader"));
+  const label = document.createElement("span");
+  label.className = "walk-title";
+  label.textContent = title;
+  head.append(num, icon, label, chevronElement());
+  const detail = document.createElement("div");
+  detail.className = "walk-detail";
+  el.append(head, detail);
+  view.reasoningBody.appendChild(el);
+  view.currentStep = { el, icon, label, detail, n };
+  scrollChat();
+  return view.currentStep;
+}
+
+function renderActionCode(action) {
+  if (action.type === "click" || action.type === "type" || action.type === "scroll") {
+    const lines = [];
+    if (action.type === "click") {
+      lines.push(`document.querySelector(${JSON.stringify(action.selector || "")})?.click();`);
+    } else if (action.type === "type") {
+      lines.push(`const el = document.querySelector(${JSON.stringify(action.selector || "")});`);
+      lines.push(`el.value = ${JSON.stringify(action.text || "")};`);
+      if (action.submit) {
+        lines.push("el.form?.requestSubmit();");
+      }
+    } else {
+      lines.push(`window.scrollBy(0, ${Number(action.y) || 600});`);
+    }
+    return lines.join("\n");
+  }
+  return JSON.stringify(action, null, 2);
+}
+
+function renderResultHtml(action, result, page) {
+  if (!result) {
+    return "";
+  }
+  if (result.ok === false) {
+    return `<div class="walk-section"><div class="walk-section-title">Data returned</div><pre class="walk-pre">${escapeHtml(result.error || "failed")}</pre></div>`;
+  }
+  if (action.type === "search" && Array.isArray(result.results)) {
+    const rows = result.results
+      .slice(0, 8)
+      .map(
+        item =>
+          `<tr><td>${escapeHtml(item.title)}</td><td>${escapeHtml(item.source)}</td></tr>`
+      )
+      .join("");
+    return `<div class="walk-section"><div class="walk-section-title">Skills found</div><table class="walk-table"><thead><tr><th>Skill</th><th>Source</th></tr></thead><tbody>${rows}</tbody></table></div>`;
+  }
+  if (action.type === "knowledge" && result.content) {
+    return `<div class="walk-section"><div class="walk-section-title">${escapeHtml(result.title || "Skill")}</div><pre class="walk-pre">${escapeHtml(result.content.slice(0, 700))}</pre></div>`;
+  }
+  if (action.type === "flag") {
+    return `<div class="walk-section"><div class="walk-section-title">Data returned</div><pre class="walk-pre">${escapeHtml(result.flag || "")}</pre></div>`;
+  }
+  if (page && page.text) {
+    const snippet = `${page.title ? `${page.title}\n` : ""}${page.text.slice(0, 500)}`;
+    return `<div class="walk-section"><div class="walk-section-title">Observation</div><pre class="walk-pre">${escapeHtml(snippet)}</pre></div>`;
+  }
+  return "";
+}
+
+function markWalkStepDone(view, stepRecord, page) {
+  const step = view.currentStep;
+  if (!step) {
+    return;
+  }
+  step.el.dataset.state = "done";
+  step.icon.replaceChildren(svgIcon("check"));
+  step.label.textContent = liveActionLabel(stepRecord.action || {}, page);
+  const detail = step.detail;
+  detail.replaceChildren();
+  if (stepRecord.thought) {
+    const thought = document.createElement("div");
+    thought.className = "walk-thought";
+    thought.textContent = stepRecord.thought;
+    detail.appendChild(thought);
+  }
+  const codeBlock = document.createElement("div");
+  codeBlock.className = "walk-section";
+  codeBlock.innerHTML = `<div class="walk-section-title">Code executed</div><pre class="walk-pre" tabindex="0">${escapeHtml(renderActionCode(stepRecord.action || {}))}</pre>`;
+  detail.appendChild(codeBlock);
+  const resultHtml = renderResultHtml(stepRecord.action || {}, stepRecord.result, page);
+  if (resultHtml) {
+    const holder = document.createElement("div");
+    holder.innerHTML = resultHtml;
+    detail.appendChild(holder);
+  }
+  view.currentStep = null;
+  scrollChat();
+}
