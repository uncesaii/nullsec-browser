+
+function renderManageModels(filter = "") {
+  const list = dom.manageList;
+  list.replaceChildren();
+  const disabled = getDisabledSet();
+  const query = filter.trim().toLowerCase();
+  for (const groupKey of ["popular", "other"]) {
+    const providers = NullSecModels.PROVIDERS.filter(
+      provider => provider.group === groupKey
+    );
+    const matched = providers
+      .map(provider => ({
+        provider,
+        models: provider.models.filter(
+          model =>
+            !query ||
+            `${provider.name} ${model.name}`.toLowerCase().includes(query)
+        ),
+      }))
+      .filter(
+        entry => entry.models.length || (!query && !entry.provider.models.length)
+      );
+    if (!matched.length) {
+      continue;
+    }
+    const heading = document.createElement("div");
+    heading.className = "overlay-group-label";
+    heading.textContent = NullSecModels.PROVIDER_GROUPS[groupKey];
+    list.appendChild(heading);
+    for (const { provider, models } of matched) {
+      const row = document.createElement("div");
+      row.className = "provider-row";
+      row.appendChild(providerTile(provider));
+      const info = document.createElement("div");
+      info.className = "provider-info";
+      const title = document.createElement("span");
+      title.className = "provider-name";
+      title.textContent = provider.name;
+      info.appendChild(title);
+      row.appendChild(info);
+      const allDisabled =
+        provider.models.length > 0 &&
+        provider.models.every(model =>
+          disabled.has(NullSecModels.makeId(provider.id, model.id))
+        );
+      row.appendChild(
+        switchEl(!allDisabled, () => {
+          const set = getDisabledSet();
+          const enable = allDisabled;
+          for (const model of provider.models) {
+            const id = NullSecModels.makeId(provider.id, model.id);
+            if (enable) {
+              set.delete(id);
+            } else {
+              set.add(id);
+            }
+          }
+          setDisabledSet(set);
+          renderManageModels(dom.manageSearch.value);
+          renderModelPill();
+        })
+      );
+      list.appendChild(row);
+      for (const model of models) {
+        const id = NullSecModels.makeId(provider.id, model.id);
+        const modelRow = document.createElement("div");
+        modelRow.className = "model-row";
+        const name = document.createElement("span");
+        name.className = "model-row-name";
+        name.textContent = model.name;
+        modelRow.appendChild(name);
+        modelRow.appendChild(
+          switchEl(!disabled.has(id), () => {
+            const set = getDisabledSet();
+            if (set.has(id)) {
+              set.delete(id);
+            } else {
+              set.add(id);
+            }
+            setDisabledSet(set);
+            renderManageModels(dom.manageSearch.value);
+            renderModelPill();
+          })
+        );
+        list.appendChild(modelRow);
+      }
+    }
+  }
+}
