+  justify-content: center;
+  width: 28px;
+}
+
+.provider-row {
+  align-items: center;
+  background-color: color-mix(in srgb, var(--ns-fg) 4%, transparent);
+  border-radius: 10px;
+  display: flex;
+  gap: 10px;
+  padding: 10px 12px;
+}
+
+.provider-info {
+  display: flex;
+  flex: 1;
+  flex-direction: column;
+  gap: 1px;
+  min-width: 0;
+}
+
+.provider-name {
+  font-size: 14px;
+  font-weight: 500;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.provider-sub {
+  color: var(--ns-muted-fg);
+  font-size: 12px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.provider-badge {
+  border: 1px solid var(--ns-border);
+  border-radius: 6px;
+  color: var(--ns-muted-fg);
+  flex: 0 0 auto;
+  font-size: 11px;
+  padding: 1px 6px;
+}
+
+.model-row {
+  align-items: center;
+  border-radius: 8px;
+  display: flex;
+  gap: 10px;
+  padding: 8px 12px;
+}
+
+.model-row:hover {
+  background-color: color-mix(in srgb, var(--ns-fg) 4%, transparent);
+}
+
+.model-row-name {
+  color: var(--ns-muted-fg);
+  flex: 1;
+  font-size: 13px;
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.connect-row {
+  align-items: center;
+  background: transparent;
+  border: none;
+  border-radius: 10px;
+  color: var(--ns-fg);
+  cursor: pointer;
+  display: flex;
+  font: inherit;
+  gap: 10px;
+  padding: 10px 12px;
+  text-align: left;
+  width: 100%;
+}
+
+.connect-row:hover {
+  background-color: color-mix(in srgb, var(--ns-fg) 6%, transparent);
+}
+
+.switch {
+  background-color: var(--ns-muted);
+  border: none;
+  border-radius: 999px;
+  cursor: pointer;
+  flex: 0 0 auto;
+  height: 16px;
+  padding: 0;
+  position: relative;
+  transition: background-color 0.15s var(--ns-ease);
+  width: 28px;
+}
+
+.switch.is-on {
+  background-color: var(--ns-link);
+}
+
+.switch-knob {
+  background-color: #ffffff;
+  border-radius: 50%;
+  height: 12px;
+  left: 2px;
+  position: absolute;
+  top: 2px;
+  transition: transform 0.15s var(--ns-ease);
+  width: 12px;
+}
+
+.switch.is-on .switch-knob {
+  transform: translateX(12px);
+}
