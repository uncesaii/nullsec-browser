+function buildSystemPrompt(agent = false) {
+  const cfg = getProviderConfig();
+  const tab = getActiveTabInfo();
+  let prompt = cfg.system || DEFAULT_SYSTEM;
+  if (tab.url) {
+    prompt += `\n\n[Current tab]\nTitle: ${tab.title}\nURL: ${tab.url}`;
+  }
+  try {
+    prompt += `\n\n[Knowledge base]\n${NullSecSkills.count()} offline security skills are available (MITRE ATT&CK, OWASP, ISECOM). Use the "search" action to find techniques and "knowledge" to read a specific skill.`;
+  } catch (error) {
+    console.error("NullSec: skills unavailable", error);
+  }
+  if (agent) {
+    prompt += `\n\n${AGENT_PROTOCOL}`;
+  }
+  return prompt;
+}
