+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--space-small);
+  padding: var(--space-small) var(--space-large) var(--space-large);
+}
+
+.settings-status {
+  color: var(--text-color-deemphasized);
+  font-size: 12px;
+  margin-inline-start: auto;
+}
