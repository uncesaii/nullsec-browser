+      if (!trimmed.startsWith("{")) {
+        return true;
+      }
+      try {
+        const parsed = JSON.parse(trimmed);
+        if (parsed && (parsed.action || parsed.thought)) {
+          return false;
+        }
+      } catch {}
+      return true;
+    })
