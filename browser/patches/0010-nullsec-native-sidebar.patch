+body {
+  height: 100%;
+  margin: 0;
+}
+
+.options-container {
+  align-items: center;
+  display: flex;
+  gap: var(--space-small);
+  width: 100%;
+}
+
+.report-select {
+  -moz-context-properties: fill;
+  appearance: none;
+  background-color: transparent;
+  background-image: url("chrome://global/skin/icons/arrow-down.svg");
+  background-position: right 4px center;
+  background-repeat: no-repeat;
+  background-size: 12px;
+  border: none;
+  border-radius: 999px;
+  color: var(--text-color);
+  cursor: pointer;
+  fill: currentColor;
+  flex: 1;
+  font-size: 13px;
+  height: 28px;
+  min-width: 0;
+  overflow: hidden;
+  padding: 0 22px 0 10px;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.report-select:hover {
+  background-color: var(--button-background-color-ghost-hover);
+}
+
+.empty {
+  color: var(--text-color-deemphasized);
+  font-size: 13px;
+  padding: var(--space-large) var(--space-small);
+  text-align: center;
+}
+
+.report-body {
+  color: var(--text-color);
+  font-size: 13px;
+  line-height: 1.6;
+  overflow-wrap: anywhere;
+}
+
+.report-body > :first-child {
+  margin-block-start: 0;
+}
+
+.report-body h1 {
+  font-size: 18px;
+  margin-block: 0 var(--space-small);
+}
+
+.report-body h2 {
+  border-block-end: 1px solid var(--border-color-deemphasized);
+  font-size: 15px;
+  margin-block: var(--space-large) var(--space-small);
+  padding-block-end: var(--space-xsmall);
+}
+
+.report-body h3 {
+  font-size: 14px;
+  margin-block: var(--space-medium) var(--space-xsmall);
+}
+
+.report-body h4,
+.report-body h5,
+.report-body h6 {
+  font-size: 13px;
+  margin-block: var(--space-small) var(--space-xsmall);
+}
+
+.report-body p,
+.report-body ul,
+.report-body ol,
+.report-body pre,
+.report-body table {
+  margin-block: 0 var(--space-small);
+}
+
+.report-body ul,
+.report-body ol {
+  padding-inline-start: var(--space-large);
+}
+
+.report-body a {
+  color: var(--link-color);
+}
+
+.report-body code {
+  background-color: var(--background-color-canvas);
+  border: 1px solid var(--border-color-deemphasized);
+  border-radius: var(--border-radius-small);
+  font-family: var(--monospace-font-family, monospace);
+  font-size: 0.92em;
+  padding: 0 3px;
+}
+
+.report-body pre {
+  background-color: var(--background-color-canvas);
+  border: 1px solid var(--border-color-deemphasized);
+  border-radius: var(--border-radius-small);
+  max-width: 100%;
+  overflow: auto;
+  padding: var(--space-small);
+}
+
+.report-body pre code {
+  background: none;
+  border: none;
+  padding: 0;
+}
+
+.report-body table {
+  border-collapse: collapse;
+  display: block;
+  font-size: 12px;
+  max-width: 100%;
+  overflow-x: auto;
+}
+
+.report-body th,
+.report-body td {
+  border: 1px solid var(--border-color-deemphasized);
+  padding: 4px 6px;
+  text-align: start;
+  vertical-align: top;
+}
+
+.report-body th {
+  background-color: var(--background-color-canvas);
+  font-weight: var(--font-weight-semibold);
+}
+
+.report-body hr {
+  border: none;
+  border-top: 1px solid var(--border-color-deemphasized);
+  margin-block: var(--space-medium);
+}
+
+.report-footer {
+  border-block-start: 1px solid var(--border-color);
+  display: flex;
+  gap: var(--space-small);
+  padding-block-start: var(--space-small);
+}
+
+.report-footer[hidden] {
+  display: none;
+}
