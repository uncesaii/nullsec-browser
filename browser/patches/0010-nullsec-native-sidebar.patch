+    view.timing = formatTiming(performance.now() - started);
+    captureFlags(assistant.content, getActiveTabInfo().url);
+    attachAssistantActions(view, { text: assistant.content });
+  } catch (error) {
+    setAssistantStatus(view, null);
+    if (error.name === "AbortError") {
+      assistant.content += "\n\n_[stopped]_";
+    } else {
+      assistant.content += `\n\n**Error:** ${error.message}`;
+    }
