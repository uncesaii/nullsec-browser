+  if (!response.ok) {
+    throw new Error(`${response.status} ${await response.text()}`);
+  }
+  await readSSE(response, data => {
+    try {
+      const parsed = JSON.parse(data);
+      const token = parsed.delta?.text;
+      if (token) {
+        onToken(token);
+      }
+    } catch {}
