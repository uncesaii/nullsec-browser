+const { IOUtils } = ChromeUtils.importESModule(
+  "resource://gre/modules/IOUtils.sys.mjs"
+);
+const { PathUtils } = ChromeUtils.importESModule(
+  "resource://gre/modules/PathUtils.sys.mjs"
+);
+
+const LOGIN_ORIGIN = "chrome://nullsec";
+const LOGIN_REALM = "NullSec AI";
+const DATA_DIR = () => PathUtils.join(PathUtils.profileDir, "nullsec");
+const DATA_FILE = () => PathUtils.join(DATA_DIR(), "data.json");
+
+const PREF = {
+  provider: "browser.nullsec.ai.provider",
+  baseurl: "browser.nullsec.ai.baseurl",
+  model: "browser.nullsec.ai.model",
+  temperature: "browser.nullsec.ai.temperature",
+  system: "browser.nullsec.ai.system",
+};
+
+const DEFAULT_SYSTEM = [
+  "You are NullSec, an offensive-security copilot embedded in a browser for authorized CTF competitions and penetration tests.",
+  "Be concise, technical, and practical. Prefer concrete commands, payloads, and next requests over theory.",
+  "When shown an HTTP exchange, inspect auth, cookies, parameters, headers, uploads, redirects, and likely vulnerability classes (IDOR, SSRF, SQLi, XSS, auth bypass, path traversal, deserialization, race conditions).",
+  "Do not help with real-world unauthorized attacks. If scope is unclear, ask for confirmation.",
+].join(" ");
+
+const PROVIDER_DEFAULTS = {
+  openai: {
+    baseurl: "https://api.openai.com/v1",
+    model: "gpt-4o-mini",
+  },
+  anthropic: {
+    baseurl: "https://api.anthropic.com",
+    model: "claude-3-5-sonnet-latest",
+  },
+  compatible: {
+    baseurl: "http://localhost:11434/v1",
+    model: "llama3.1",
+  },
+};
+
+const state = {
+  data: { targets: [], notes: {} },
+  selectedTargetId: "global",
+  traffic: [],
+  trafficSeq: 0,
+  trafficPaused: false,
+  trafficFilter: "",
+  trafficMethod: "",
+  selectedRequestId: null,
+  messages: [],
+  streaming: false,
+  abortController: null,
+  notesSaveTimer: null,
+};
+
+const dom = {};
+
+function $(id) {
+  return document.getElementById(id);
+}
+
+function getBrowserWindow() {
+  try {
+    const win = window.browsingContext?.topChromeWindow;
+    if (win?.gBrowser) {
+      return win;
+    }
+  } catch {}
+  try {
+    if (window.top?.gBrowser) {
+      return window.top;
+    }
+  } catch {}
+  return Services.wm.getMostRecentWindow("navigator:browser");
+}
+
+function getActiveTabInfo() {
+  const win = getBrowserWindow();
+  const browser = win?.gBrowser?.selectedBrowser;
+  if (!browser) {
+    return { title: "", url: "" };
+  }
+  let url = "";
+  try {
+    url = browser.currentURI?.spec || browser.currentURI?.displaySpec || "";
+  } catch {}
+  return {
+    title: browser.contentTitle || "",
+    url,
+  };
+}
+
+function escapeHtml(text) {
+  return String(text)
+    .replaceAll("&", "&amp;")
+    .replaceAll("<", "&lt;")
+    .replaceAll(">", "&gt;")
+    .replaceAll('"', "&quot;");
+}
+
+function renderMarkdown(text) {
+  const parts = String(text).split(/```/);
+  let html = "";
+  parts.forEach((part, index) => {
+    if (index % 2 === 1) {
+      const trimmed = part.replace(/^\w*\n/, "");
+      html += `<pre><code>${escapeHtml(trimmed)}</code></pre>`;
+      return;
+    }
+    let chunk = escapeHtml(part);
+    chunk = chunk.replace(/`([^`]+)`/g, "<code>$1</code>");
+    chunk = chunk.replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>");
+    chunk = chunk.replace(
+      /(https?:\/\/[^\s<]+)/g,
+      '<a href="$1" target="_blank" rel="noreferrer">$1</a>'
+    );
+    html += chunk;
+  });
+  return html;
+}
+
+function copyText(text) {
+  const helper = Cc["@mozilla.org/widget/clipboardhelper;1"].getService(
+    Ci.nsIClipboardHelper
+  );
+  helper.copyString(text);
+}
+
+function formatBytes(value) {
+  if (!Number.isFinite(value) || value < 0) {
+    return "";
+  }
+  if (value < 1024) {
+    return `${value} B`;
+  }
+  if (value < 1024 * 1024) {
+    return `${(value / 1024).toFixed(1)} KB`;
+  }
+  return `${(value / (1024 * 1024)).toFixed(1)} MB`;
+}
+
+function statusClass(status) {
+  if (!status) {
+    return "";
+  }
+  if (status >= 500) {
+    return "is-error";
+  }
+  if (status >= 400) {
+    return "is-error";
+  }
+  if (status >= 300) {
+    return "is-redirect";
+  }
+  if (status >= 200) {
+    return "is-ok";
+  }
+  return "";
+}
+
+function splitUrl(url) {
+  try {
+    const parsed = new URL(url);
+    return {
+      host: parsed.host,
+      path: `${parsed.pathname}${parsed.search}`,
+    };
+  } catch {
+    return { host: url, path: "" };
+  }
+}
+
+function apiUrl(base, path) {
+  const clean = base.replace(/\/+$/, "");
+  if (clean.endsWith("/v1")) {
+    return `${clean}${path}`;
+  }
+  return `${clean}/v1${path}`;
+}
+
+function anthropicUrl(base) {
+  const clean = base.replace(/\/+$/, "");
+  if (clean.endsWith("/v1")) {
+    return `${clean}/messages`;
+  }
+  return `${clean}/v1/messages`;
+}
+
+function findLogin(provider) {
+  try {
+    const logins = Services.logins.findLogins(LOGIN_ORIGIN, null, LOGIN_REALM);
+    return logins.find(login => login.username === provider) || null;
+  } catch {
+    return null;
+  }
+}
+
+function getKey(provider) {
+  return findLogin(provider)?.password || "";
+}
+
+function makeLogin(provider, key) {
+  const login = Cc["@mozilla.org/login-manager/loginInfo;1"].createInstance(
+    Ci.nsILoginInfo
+  );
+  login.init(LOGIN_ORIGIN, null, LOGIN_REALM, provider, key, "", "");
+  return login;
+}
+
+function setKey(provider, key) {
+  try {
+    const existing = findLogin(provider);
+    if (!key) {
+      if (existing) {
+        Services.logins.removeLogin(existing);
+      }
+      return true;
+    }
+    if (existing) {
+      Services.logins.modifyLogin(existing, makeLogin(provider, key));
+    } else {
+      Services.logins.addLogin(makeLogin(provider, key));
+    }
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+function getProviderConfig() {
+  const provider = Services.prefs.getStringPref(
+    PREF.provider,
+    "openai"
+  );
+  const defaults = PROVIDER_DEFAULTS[provider] || PROVIDER_DEFAULTS.openai;
+  return {
+    provider,
+    baseurl: Services.prefs.getStringPref(PREF.baseurl, defaults.baseurl),
+    model: Services.prefs.getStringPref(PREF.model, defaults.model),
+    temperature: Services.prefs.getStringPref(PREF.temperature, "0.3"),
+    system: Services.prefs.getStringPref(PREF.system, DEFAULT_SYSTEM),
+  };
+}
+
+function getSelectedTarget() {
+  if (state.selectedTargetId === "global") {
+    return null;
+  }
+  return state.data.targets.find(t => t.id === state.selectedTargetId) || null;
+}
+
+function buildSystemPrompt() {
+  const cfg = getProviderConfig();
+  const tab = getActiveTabInfo();
+  const target = getSelectedTarget();
+  let prompt = cfg.system || DEFAULT_SYSTEM;
+  if (tab.url) {
+    prompt += `\n\n[Current tab]\nTitle: ${tab.title}\nURL: ${tab.url}`;
+  }
+  if (target) {
+    prompt += `\n\n[Selected target]\nName: ${target.name}\nScope: ${target.scope || "unspecified"}`;
+  }
+  return prompt;
+}
+
+async function loadData() {
+  try {
+    const raw = await IOUtils.readUTF8(DATA_FILE());
+    const parsed = JSON.parse(raw);
+    state.data.targets = Array.isArray(parsed.targets) ? parsed.targets : [];
+    state.data.notes =
+      parsed.notes && typeof parsed.notes === "object" ? parsed.notes : {};
+  } catch {
+    state.data = { targets: [], notes: {} };
+  }
+}
+
+let saveTimer = null;
+function scheduleSave() {
+  clearTimeout(saveTimer);
+  saveTimer = setTimeout(saveData, 350);
+}
+
+async function saveData() {
+  try {
+    await IOUtils.makeDirectory(DATA_DIR(), { ignoreExisting: true });
+    await IOUtils.writeUTF8(
+      DATA_FILE(),
+      JSON.stringify(state.data, null, 2)
+    );
+  } catch (error) {
+    setNotesStatus(`Save failed: ${error.message}`);
+  }
+}
+
+function setNotesStatus(text) {
+  if (dom.notesStatus) {
+    dom.notesStatus.textContent = text;
+  }
+}
+
+function syncTargetSelects() {
+  const options = [
+    { id: "global", name: "Global" },
+    ...state.data.targets.map(t => ({ id: t.id, name: t.name })),
+  ];
+  for (const select of [dom.notesTarget, dom.flagTarget]) {
+    if (!select) {
+      continue;
+    }
+    select.replaceChildren();
+    for (const option of options) {
+      const el = document.createElement("option");
+      el.value = option.id;
+      el.textContent = option.name;
+      select.appendChild(el);
+    }
+    if (options.some(o => o.id === state.selectedTargetId)) {
+      select.value = state.selectedTargetId;
+    }
+  }
+}
+
+function renderTargets() {
+  if (!dom.targetsList) {
+    return;
+  }
+  dom.targetsList.replaceChildren();
+  if (!state.data.targets.length) {
+    const empty = document.createElement("div");
+    empty.className = "ns-empty-inline";
+    empty.textContent = "No targets yet. Add one above.";
+    dom.targetsList.appendChild(empty);
+    return;
+  }
+  for (const target of state.data.targets) {
+    const card = document.createElement("div");
+    card.className = "ns-target";
+    if (target.id === state.selectedTargetId) {
+      card.style.borderColor = "var(--ns-accent)";
+    }
+
+    const head = document.createElement("div");
+    head.className = "ns-target-head";
+    const name = document.createElement("span");
+    name.className = "ns-target-name";
+    name.textContent = target.name;
+    const status = document.createElement("button");
+    status.className = `ns-status${target.owned ? " is-owned" : ""}`;
+    status.textContent = target.owned ? "owned" : "active";
+    status.title = "Toggle target status";
+    status.addEventListener("click", () => {
+      target.owned = !target.owned;
+      scheduleSave();
+      renderTargets();
+    });
+    head.append(name, status);
+    card.appendChild(head);
+
+    if (target.scope) {
+      const scope = document.createElement("div");
+      scope.className = "ns-target-scope";
+      scope.textContent = target.scope;
+      card.appendChild(scope);
+    }
+
+    const flags = document.createElement("div");
+    flags.className = "ns-target-flags";
+    for (const flag of target.flags || []) {
+      const chip = document.createElement("span");
+      chip.className = "ns-flag";
+      chip.textContent = flag;
+      flags.appendChild(chip);
+    }
+    if (flags.childElementCount) {
+      card.appendChild(flags);
+    }
+
+    const actions = document.createElement("div");
+    actions.className = "ns-detail-actions";
+    const select = document.createElement("button");
+    select.className = "ns-btn ns-btn-ghost";
+    select.textContent = "Notes";
+    select.addEventListener("click", () => {
+      state.selectedTargetId = target.id;
+      syncTargetSelects();
+      loadNotesForTarget();
+      switchTab("notes");
+    });
+    const remove = document.createElement("button");
+    remove.className = "ns-btn ns-btn-ghost";
+    remove.textContent = "Delete";
+    remove.addEventListener("click", () => {
+      if (!window.confirm(`Delete target "${target.name}"?`)) {
+        return;
+      }
+      state.data.targets = state.data.targets.filter(t => t.id !== target.id);
+      delete state.data.notes[target.id];
+      if (state.selectedTargetId === target.id) {
+        state.selectedTargetId = "global";
+      }
+      scheduleSave();
+      syncTargetSelects();
+      renderTargets();
+      loadNotesForTarget();
+    });
+    actions.append(select, remove);
+    card.appendChild(actions);
+
+    dom.targetsList.appendChild(card);
+  }
+}
+
+function loadNotesForTarget() {
+  if (!dom.notesEditor) {
+    return;
+  }
+  dom.notesEditor.value = state.data.notes[state.selectedTargetId] || "";
+  setNotesStatus("");
+}
+
+function scheduleNotesSave() {
+  clearTimeout(state.notesSaveTimer);
+  state.notesSaveTimer = setTimeout(() => {
+    state.data.notes[state.selectedTargetId] = dom.notesEditor.value;
+    scheduleSave();
+    setNotesStatus("Saved");
+    setTimeout(() => setNotesStatus(""), 1200);
+  }, 400);
+}
+
+function switchTab(tab) {
+  for (const button of document.querySelectorAll(".ns-tab")) {
+    button.classList.toggle("is-active", button.dataset.tab === tab);
+  }
+  for (const panel of document.querySelectorAll(".ns-panel")) {
+    panel.classList.toggle("is-active", panel.dataset.panel === tab);
+  }
+  if (tab === "traffic") {
+    renderTraffic();
+  }
+}
+
+function updateContext() {
+  const tab = getActiveTabInfo();
+  if (!dom.aiContextText) {
+    return;
+  }
+  if (!tab.url) {
+    dom.aiContextText.textContent = "No active tab";
+    dom.aiContextText.title = "";
+    return;
+  }
+  const label = tab.title ? `${tab.title}` : tab.url;
+  dom.aiContextText.textContent = label;
+  dom.aiContextText.title = `${tab.title}\n${tab.url}`;
+}
+
+function setStreaming(value) {
+  state.streaming = value;
+  dom.chatSend.disabled = value;
+  dom.chatStop.hidden = !value;
+}
+
+function clearChat() {
+  state.messages = [];
+  for (const node of document.querySelectorAll(".ns-msg")) {
+    node.remove();
+  }
+  dom.chatEmpty.hidden = false;
+}
+
+function scrollChat() {
