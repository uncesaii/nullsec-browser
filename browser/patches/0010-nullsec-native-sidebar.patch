+
+function svgIcon(name, className = "ns-svg") {
+  const span = document.createElement("span");
+  span.className = className;
+  span.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${NS_ICON[name] || ""}</svg>`;
+  if (name === "loader") {
+    span.firstChild.classList.add("spin");
+  }
+  return span;
+}
+
+function chevronElement() {
+  return svgIcon("chevronDown", "ns-svg chevron");
+}
+
+function dotsElement() {
+  const dots = document.createElement("span");
+  dots.className = "dots";
+  for (let row = 0; row < 5; row++) {
+    for (let col = 0; col < 5; col++) {
+      const dot = document.createElement("i");
+      const ring = Math.max(Math.abs(row - 2), Math.abs(col - 2));
+      dot.style.animationDelay = `${-ring * 0.18}s`;
+      dots.appendChild(dot);
+    }
+  }
+  return dots;
+}
