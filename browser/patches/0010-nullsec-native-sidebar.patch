+async function sendChat(text) {
+  const trimmed = text.trim();
+  if (!trimmed || state.streaming) {
+    return;
+  }
+  const cfg = getProviderConfig();
+  const key = getKey(cfg.provider);
+  if (!key && cfg.provider !== "compatible") {
+    dom.aiSettings.hidden = false;
+    dom.aiStatus.textContent = "Add an API key for this provider.";
+    return;
+  }
+  dom.aiSettings.hidden = true;
