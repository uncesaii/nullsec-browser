+}
+
+.report-body {
+  color: var(--text-color);
+  font-size: 13px;
+  line-height: 1.6;
+  overflow-wrap: anywhere;
+}
+
+.report-body > :first-child {
+  margin-block-start: 0;
+}
+
+.report-body h1 {
+  font-size: 18px;
+  margin-block: 0 var(--space-small);
+}
+
+.report-body h2 {
+  border-block-end: 1px solid var(--border-color-deemphasized);
+  font-size: 15px;
+  margin-block: var(--space-large) var(--space-small);
+  padding-block-end: var(--space-xsmall);
+}
+
+.report-body h3 {
+  font-size: 14px;
+  margin-block: var(--space-medium) var(--space-xsmall);
+}
+
+.report-body h4,
+.report-body h5,
+.report-body h6 {
+  font-size: 13px;
+  margin-block: var(--space-small) var(--space-xsmall);
+}
+
+.report-body p,
+.report-body ul,
+.report-body ol,
+.report-body pre,
+.report-body table {
+  margin-block: 0 var(--space-small);
+}
+
+.report-body ul,
+.report-body ol {
+  padding-inline-start: var(--space-large);
+}
+
+.report-body a {
+  color: var(--link-color);
+}
+
+.report-body code {
+  background-color: var(--background-color-canvas);
+  border: 1px solid var(--border-color-deemphasized);
+  border-radius: var(--border-radius-small);
+  font-family: var(--monospace-font-family, monospace);
+  font-size: 0.92em;
+  padding: 0 3px;
+}
+
+.report-body pre {
