+        "",
+        "[Page context]",
+        `URL: ${page.url}`,
+        `TITLE: ${page.title}`,
+        "",
+        "VISIBLE TEXT:",
+        page.text,
+        "",
+        "INTERACTIVE ELEMENTS:",
+        JSON.stringify(page.controls),
+      ].join("\n");
+    }
+  }
