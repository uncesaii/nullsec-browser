diff --git a/browser/components/nullsec/reports.mjs b/browser/components/nullsec/reports.mjs
new file mode 100644
index 00000000..c9cd4b19
--- /dev/null
+++ b/browser/components/nullsec/reports.mjs
@@ -0,0 +1,274 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+const NullSecStore = ChromeUtils.importESModule(
+  "moz-src:///browser/components/nullsec/NullSecStore.sys.mjs"
+);
+
+const state = {
+  selectedId: null,
+};
+
+const dom = {};
+
+function $(id) {
+  return document.getElementById(id);
+}
+
+function escapeHtml(text) {
+  return String(text)
+    .replaceAll("&", "&amp;")
+    .replaceAll("<", "&lt;")
+    .replaceAll(">", "&gt;")
+    .replaceAll('"', "&quot;");
+}
+
+function renderInline(text) {
+  let chunk = String(text);
+  chunk = chunk.replace(/`([^`]+)`/g, "<code>$1</code>");
+  chunk = chunk.replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>");
+  chunk = chunk.replace(
+    /(^|[\s(])_([^_\n]+)_(?=[\s).,!?:;]|$)/g,
+    "$1<em>$2</em>"
+  );
+  chunk = chunk.replace(
+    /(https?:\/\/[^\s<]+)/g,
+    '<a href="$1" target="_blank" rel="noreferrer">$1</a>'
+  );
+  return chunk;
+}
+
+function splitTableRow(line) {
+  let row = line.trim();
+  if (row.startsWith("|")) {
+    row = row.slice(1);
+  }
+  if (row.endsWith("|")) {
+    row = row.slice(0, -1);
+  }
+  return row.split("|").map(cell => cell.trim());
+}
+
+function renderBlocks(text) {
+  const lines = text.split(/\r?\n/);
+  const html = [];
+  let paragraph = [];
+  let list = null;
+  const flushParagraph = () => {
+    if (paragraph.length) {
+      html.push(`<p>${paragraph.join("<br>")}</p>`);
+      paragraph = [];
+    }
+  };
+  const flushList = () => {
+    if (list) {
+      html.push(
+        `<${list.type}>${list.items
+          .map(item => `<li>${item}</li>`)
+          .join("")}</${list.type}>`
+      );
+      list = null;
+    }
+  };
+  for (let index = 0; index < lines.length; index++) {
+    const trimmed = lines[index].trim();
+    if (!trimmed) {
+      flushParagraph();
+      flushList();
+      continue;
+    }
+    const heading = trimmed.match(/^(#{1,6})\s+(.*)$/);
+    if (heading) {
+      flushParagraph();
+      flushList();
+      const level = heading[1].length;
+      html.push(`<h${level}>${renderInline(heading[2])}</h${level}>`);
+      continue;
+    }
+    if (/^(-{3,}|\*{3,}|_{3,})$/.test(trimmed)) {
+      flushParagraph();
+      flushList();
+      html.push("<hr>");
+      continue;
+    }
+    if (
+      trimmed.includes("|") &&
+      lines[index + 1] &&
+      /^\s*\|?\s*:?-{2,}/.test(lines[index + 1])
+    ) {
+      flushParagraph();
+      flushList();
+      const header = splitTableRow(trimmed);
+      const rows = [];
+      index += 2;
+      while (index < lines.length && lines[index].trim().includes("|")) {
+        rows.push(splitTableRow(lines[index]));
+        index++;
+      }
+      index--;
+      html.push(
+        `<table><thead><tr>${header
+          .map(cell => `<th>${renderInline(cell)}</th>`)
+          .join("")}</tr></thead><tbody>${rows
+          .map(
+            row =>
+              `<tr>${row
+                .map(cell => `<td>${renderInline(cell)}</td>`)
+                .join("")}</tr>`
+          )
+          .join("")}</tbody></table>`
+      );
+      continue;
+    }
+    const bullet = trimmed.match(/^[-*]\s+(.*)$/);
+    if (bullet) {
+      flushParagraph();
+      if (!list || list.type !== "ul") {
+        flushList();
+        list = { type: "ul", items: [] };
+      }
+      list.items.push(renderInline(bullet[1]));
+      continue;
+    }
+    const numbered = trimmed.match(/^\d+[.)]\s+(.*)$/);
+    if (numbered) {
+      flushParagraph();
+      if (!list || list.type !== "ol") {
+        flushList();
+        list = { type: "ol", items: [] };
+      }
+      list.items.push(renderInline(numbered[1]));
+      continue;
+    }
+    flushList();
+    paragraph.push(renderInline(trimmed));
+  }
+  flushParagraph();
+  flushList();
+  return html.join("");
+}
+
+function renderMarkdown(text) {
+  const parts = String(text).split(/```/);
+  let html = "";
+  parts.forEach((part, index) => {
+    if (index % 2 === 1) {
+      const trimmed = part.replace(/^\w*\n/, "");
+      html += `<pre><code>${escapeHtml(trimmed)}</code></pre>`;
+      return;
+    }
+    html += renderBlocks(escapeHtml(part));
+  });
+  return html;
+}
+
+function copyText(text) {
+  const helper = Cc["@mozilla.org/widget/clipboardhelper;1"].getService(
+    Ci.nsIClipboardHelper
+  );
+  helper.copyString(text);
+}
+
+function currentReport() {
+  const reports = NullSecStore.getReports();
+  if (!reports.length) {
+    return null;
+  }
+  return reports.find(report => report.id === state.selectedId) || reports[0];
+}
+
+function renderSelect(reports) {
+  dom.select.replaceChildren();
+  if (!reports.length) {
+    return;
+  }
+  for (const report of reports) {
+    const option = document.createElement("option");
+    option.value = report.id;
+    option.textContent = report.title || report.id;
+    dom.select.appendChild(option);
+  }
+  const selected = currentReport();
+  if (selected) {
+    dom.select.value = selected.id;
+  }
+}
+
+function render() {
+  const reports = NullSecStore.getReports();
+  const report = currentReport();
+  renderSelect(reports);
+  if (!report) {
+    dom.empty.hidden = false;
+    dom.body.hidden = true;
+    dom.actions.hidden = true;
+    return;
+  }
+  state.selectedId = report.id;
+  dom.empty.hidden = true;
+  dom.body.hidden = false;
+  dom.actions.hidden = false;
+  dom.body.innerHTML = renderMarkdown(report.markdown);
+}
+
+function init() {
+  dom.select = $("report-select");
+  dom.empty = $("report-empty");
+  dom.body = $("report-body");
+  dom.actions = $("report-actions");
+  dom.copy = $("report-copy");
+  dom.save = $("report-save");
+  dom.clear = $("report-clear");
+
+  dom.select.addEventListener("change", () => {
+    state.selectedId = dom.select.value;
+    render();
+  });
+  dom.copy.addEventListener("click", () => {
+    const report = currentReport();
+    if (!report) {
+      return;
+    }
+    copyText(report.markdown);
+    dom.copy.textContent = "Copied";
+    setTimeout(() => (dom.copy.textContent = "Copy"), 1200);
+  });
+  dom.save.addEventListener("click", async () => {
+    const report = currentReport();
+    if (!report) {
+      return;
+    }
+    try {
+      const dir = PathUtils.join(PathUtils.profileDir, "nullsec");
+      await IOUtils.makeDirectory(dir, { ignoreExisting: true });
+      const path = PathUtils.join(
+        dir,
+        report.id === "current" ? "nullsec-report.md" : `${report.id}.md`
+      );
+      await IOUtils.writeUTF8(path, report.markdown);
+      dom.save.textContent = "Saved";
+      dom.save.title = path;
+      setTimeout(() => (dom.save.textContent = "Save .md"), 1500);
+    } catch (error) {
+      dom.save.textContent = "Failed";
+      dom.save.title = error.message;
+    }
+  });
+  dom.clear.addEventListener("click", () => {
+    NullSecStore.clearReports();
+    state.selectedId = null;
+    render();
+  });
+
+  const unsubscribe = NullSecStore.subscribe(type => {
+    if (type === "reports") {
+      render();
+    }
+  });
+  window.addEventListener("unload", unsubscribe, { once: true });
+
+  render();
+}
+
+init();
