+
+async function readSSE(response, onData) {
+  if (!response.body) {
+    throw new Error("Streaming response has no body");
+  }
+  const reader = response.body.getReader();
+  const decoder = new TextDecoder();
+  let buffer = "";
+  for (;;) {
+    const { value, done } = await reader.read();
+    if (done) {
+      break;
+    }
+    buffer += decoder.decode(value, { stream: true });
+    let index = buffer.indexOf("\n");
+    while (index >= 0) {
+      const line = buffer.slice(0, index).replace(/\r$/, "");
+      buffer = buffer.slice(index + 1);
+      if (line.startsWith("data:")) {
+        const data = line.slice(5).trim();
+        if (data) {
+          onData(data);
+        }
+      }
+      index = buffer.indexOf("\n");
+    }
+  }
+}
+
+async function streamOpenAI({ cfg, key, messages, signal, onToken, system }) {
+  const anonymous = getBoolPref(PREF.anonymous, true);
+  const isOpenAIHost = /(^|\.)openai\.com/.test(cfg.baseurl || "");
+  const body = {
+    model: cfg.model,
+    stream: true,
+    temperature: Number(cfg.temperature) || 0,
+    messages: [
+      { role: "system", content: system ?? buildSystemPrompt() },
+      ...messages,
+    ],
+  };
+  if (anonymous && isOpenAIHost) {
+    // Ask OpenAI to disable server-side storage of this request.
+    body.store = false;
+  }
+  const response = await fetch(apiUrl(cfg.baseurl, "/chat/completions"), {
+    method: "POST",
+    signal,
+    headers: {
+      "Content-Type": "application/json",
+      Authorization: `Bearer ${key}`,
+    },
+    body: JSON.stringify(body),
+  });
+  if (!response.ok) {
+    throw new Error(`${response.status} ${await response.text()}`);
+  }
+  await readSSE(response, data => {
+    if (data === "[DONE]") {
+      return;
+    }
+    try {
+      const parsed = JSON.parse(data);
+      const token = parsed.choices?.[0]?.delta?.content;
+      if (token) {
+        onToken(token);
+      }
+    } catch {}
+  });
+}
+
+async function streamAnthropic({ cfg, key, messages, signal, onToken, system }) {
+  const response = await fetch(anthropicUrl(cfg.baseurl), {
+    method: "POST",
+    signal,
+    headers: {
+      "Content-Type": "application/json",
+      "x-api-key": key,
+      "anthropic-version": "2023-06-01",
+      "anthropic-dangerous-direct-browser-access": "true",
+    },
+    body: JSON.stringify({
+      model: cfg.model,
+      max_tokens: 4096,
+      stream: true,
+      temperature: Number(cfg.temperature) || 0,
+      system: system ?? buildSystemPrompt(),
+      messages,
+    }),
+  });
+  if (!response.ok) {
+    throw new Error(`${response.status} ${await response.text()}`);
+  }
+  await readSSE(response, data => {
+    try {
+      const parsed = JSON.parse(data);
+      const token = parsed.delta?.text;
+      if (token) {
+        onToken(token);
+      }
+    } catch {}
+  });
+}
+
+async function sendChat(text) {
+  const trimmed = text.trim();
+  if (!trimmed || state.streaming) {
+    return;
+  }
+  if (wantsReport(trimmed)) {
+    addUserMessage(trimmed);
+    dom.input.value = "";
+    autoGrowInput();
+    const view = createAssistantView();
+    setAssistantStatus(view, null);
+    view.status.hidden = true;
+    view.body.innerHTML = renderMarkdown(
+      "The engagement report has been generated and opened in the **Reports** panel."
+    );
+    attachAssistantActions(view, {
+      text: "Report generated.",
+      allowRegenerate: false,
+    });
+    generateReport({ open: true });
+    return;
+  }
+  if (getBoolPref(PREF.autopilot, false)) {
+    return runAgent(trimmed);
+  }
+  if (!isAiConfigured()) {
+    showSettings(false);
+    addUserMessage(trimmed);
+    dom.input.value = "";
+    autoGrowInput();
+    const view = createAssistantView();
+    view.status.hidden = true;
+    renderSetupCard(view);
+    updateWelcome();
+    return;
+  }
+  state.session.objectives.push(trimmed);
+  const cfg = getProviderConfig();
+  const key = getKey(cfg.provider);
+  showSettings(false);
+
+  let userContent = trimmed;
+  if (getBoolPref(PREF.pageContext, true)) {
+    const page = await collectPageContext();
+    if (page) {
+      userContent = [
+        trimmed,
+        "",
+        "[Page context]",
+        `URL: ${page.url}`,
+        `TITLE: ${page.title}`,
+        "",
+        "VISIBLE TEXT:",
+        page.text,
+        "",
+        "INTERACTIVE ELEMENTS:",
+        JSON.stringify(page.controls),
+      ].join("\n");
+    }
+  }
+
+  try {
+    const matches = NullSecSkills.search(trimmed, 2);
+    const excerpts = matches
+      .map(item => {
+        const skill = NullSecSkills.get(item.id);
+        return skill ? `### ${skill.title}\n${skill.content.slice(0, 1200)}` : "";
+      })
+      .filter(Boolean);
+    if (excerpts.length) {
+      userContent += `\n\n[Relevant security knowledge]\n${excerpts.join("\n\n")}`;
+    }
+  } catch (error) {
+    console.error("NullSec: skill retrieval failed", error);
+  }
+
+  state.messages.push({ role: "user", content: userContent });
+  addUserMessage(trimmed);
+  dom.input.value = "";
+  autoGrowInput();
+
+  const assistant = { role: "assistant", content: "" };
+  state.messages.push(assistant);
+  const view = createAssistantView();
+  startStatusRotation(view);
+  const started = performance.now();
+  let firstToken = true;
+  const cursor = document.createElement("span");
+  cursor.className = "cursor";
+
+  state.abortController = new AbortController();
+  setStreaming(true);
+  try {
+    const history = state.messages.slice(0, -1).slice(-24);
+    const args = {
+      cfg,
+      key,
+      messages: history,
+      signal: state.abortController.signal,
+      onToken: token => {
+        assistant.content += token;
+        if (firstToken) {
+          firstToken = false;
+          stopStatusRotation(view);
+          setAssistantStatus(view, null);
+        }
+        view.body.replaceChildren(
+          document.createTextNode(assistant.content),
+          cursor
+        );
+        scrollChat();
+      },
+    };
+    if (cfg.api === "anthropic") {
+      await streamAnthropic(args);
+    } else {
+      await streamOpenAI(args);
+    }
+    stopStatusRotation(view);
+    setAssistantStatus(view, null);
+    view.body.innerHTML = renderMarkdown(assistant.content);
+    view.timing = formatTiming(performance.now() - started);
+    captureFlags(assistant.content, getActiveTabInfo().url);
+    attachAssistantActions(view, { text: assistant.content });
+  } catch (error) {
+    stopStatusRotation(view);
+    setAssistantStatus(view, null);
+    if (error.name === "AbortError") {
+      assistant.content += "\n\n_[stopped]_";
+    } else {
+      assistant.content += `\n\n${friendlyError(error)}`;
+    }
+    view.body.innerHTML = renderMarkdown(assistant.content);
+    view.timing = formatTiming(performance.now() - started);
+    attachAssistantActions(view, { text: assistant.content });
+    if (keyErrorNeedsSettings(error)) {
+      view.actions?.prepend(
+        actionButton("Open AI settings", () => showSettings(true))
+      );
+    }
+  } finally {
+    stopStatusRotation(view);
+    setStreaming(false);
+    state.abortController = null;
+    state.session.lastAnswer = assistant.content;
+    scrollChat();
+  }
+}
+
+function getBoolPref(name, fallback) {
+  try {
+    return Services.prefs.getBoolPref(name, fallback);
+  } catch {
+    return fallback;
+  }
+}
+
+function sleep(ms) {
+  return new Promise(resolve => setTimeout(resolve, ms));
+}
+
+function pageActor() {
+  const win = getBrowserWindow();
+  const browsingContext = win?.gBrowser?.selectedBrowser?.browsingContext;
+  const global = browsingContext?.currentWindowGlobal;
+  if (!global) {
+    return null;
+  }
+  try {
+    return global.getActor("NullSec") || null;
+  } catch {
+    return null;
+  }
+}
+
+async function collectPageContext() {
+  for (let attempt = 0; attempt < 3; attempt++) {
+    const actor = pageActor();
+    if (actor) {
+      try {
+        return await actor.sendQuery("NullSec:read");
+      } catch {}
+    }
+    await sleep(700);
+  }
+  return null;
+}
+
+async function executeAction(action) {
+  const win = getBrowserWindow();
+  const browser = win?.gBrowser?.selectedBrowser;
+  if (!action || !browser) {
+    return { ok: false, error: "no active tab" };
+  }
+  const principal = Services.scriptSecurityManager.getSystemPrincipal();
+  switch (action.type) {
+    case "navigate":
+      browser.loadURI(Services.io.newURI(action.url), {
+        triggeringPrincipal: principal,
+      });
+      return { ok: true, navigated: action.url };
+    case "back":
+      win.gBrowser.goBack();
+      return { ok: true };
+    case "forward":
+      win.gBrowser.goForward();
+      return { ok: true };
+    case "read":
+      return { ok: true };
+    case "flag": {
+      const value = String(action.value || "").trim();
+      if (!value) {
+        return { ok: false, error: "missing flag value" };
+      }
+      const tab = getActiveTabInfo();
+      const entry = NullSecStore.addFlag(
+        value,
+        tab.url,
+        action.note || "Recorded by NullSec"
+      );
+      return entry
+        ? { ok: true, flag: value }
+        : { ok: true, duplicate: true, flag: value };
+    }
+    case "report":
+      generateReport({ open: true });
+      return { ok: true, report: true };
+    case "search": {
+      const results = NullSecSkills.search(action.query || "", 8);
+      return {
+        ok: true,
+        results: results.map(item => ({
+          id: item.id,
+          title: item.title,
+          source: item.source,
+          summary: item.summary,
+        })),
+      };
+    }
+    case "knowledge": {
+      const skill = NullSecSkills.get(action.id);
+      if (!skill) {
+        return { ok: false, error: `unknown skill: ${action.id}` };
+      }
+      return {
+        ok: true,
+        id: skill.id,
+        title: skill.title,
+        source: skill.source,
+        content: skill.content.slice(0, 8000),
+      };
+    }
+    case "click":
+    case "type":
+    case "scroll": {
+      const actor = pageActor();
+      if (!actor) {
+        return { ok: false, error: "page actor unavailable" };
+      }
+      if (action.type === "click") {
+        return actor.sendQuery("NullSec:click", {
+          selector: action.selector,
+        });
+      }
+      if (action.type === "type") {
+        return actor.sendQuery("NullSec:type", {
+          selector: action.selector,
+          text: action.text,
+          submit: action.submit,
+        });
+      }
+      return actor.sendQuery("NullSec:scroll", { y: action.y });
+    }
+    default:
+      return { ok: false, error: `unknown action: ${action.type}` };
+  }
+}
+
+function extractJson(text) {
+  const source = String(text);
+  const candidates = [];
+  const fence = source.match(/```(?:json)?\s*([\s\S]*?)```/i);
+  if (fence) {
+    candidates.push(fence[1]);
+  }
+  const start = source.indexOf("{");
+  const end = source.lastIndexOf("}");
+  if (start >= 0 && end > start) {
+    candidates.push(source.slice(start, end + 1));
+  }
+  for (const candidate of candidates) {
+    try {
+      const parsed = JSON.parse(candidate);
+      if (parsed && typeof parsed === "object") {
+        return parsed;
+      }
+    } catch {}
+  }
+  return null;
+}
+
+function describeAction(action) {
+  switch (action.type) {
+    case "click":
+      return `Clicking ${action.selector}`;
+    case "type":
+      return `Typing into ${action.selector}`;
+    case "navigate":
+      return `Navigating to ${action.url}`;
+    case "scroll":
+      return `Scrolling by ${action.y || 600}px`;
+    case "back":
+      return "Going back";
+    case "forward":
+      return "Going forward";
+    case "read":
+      return "Reading the page";
+    case "flag":
+      return `Recording flag ${action.value}`;
+    case "report":
+      return "Generating the engagement report";
+    case "search":
+      return `Searching the knowledge base for "${action.query || ""}"`;
+    case "knowledge":
+      return `Reading skill ${action.id || ""}`;
+    default:
+      return `Action: ${action.type}`;
+  }
+}
+
+function cleanAssistantText(text) {
+  let out = String(text || "");
+  out = out.replace(/```(?:json)?\s*[\s\S]*?```/gi, "");
+  out = out.replace(/\{\s*"(?:thought|action|answer)"[\s\S]*?\}\s*$/g, "");
+  out = out
+    .split(/\r?\n/)
+    .filter(line => {
+      const trimmed = line.trim();
+      if (!trimmed.startsWith("{")) {
+        return true;
+      }
+      try {
+        const parsed = JSON.parse(trimmed);
+        if (parsed && (parsed.action || parsed.thought)) {
+          return false;
+        }
+      } catch {}
+      return true;
+    })
+    .join("\n");
+  return out.replace(/\n{3,}/g, "\n\n").trim();
+}
+
+function captureFlags(text, url = "") {
+  if (!text) {
+    return;
+  }
+  const matches = String(text).match(FLAG_PATTERN) || [];
+  for (const value of matches) {
+    NullSecStore.addFlag(value, url, "Detected in page or model output");
+  }
+}
+
+async function completeChat({ cfg, key, messages, signal, system, onToken }) {
+  let output = "";
+  const args = {
+    cfg,
+    key,
+    messages,
+    signal,
+    system,
+    onToken: token => {
+      output += token;
+      if (onToken) {
+        onToken(token, output);
+      }
+    },
+  };
+  if (cfg.api === "anthropic") {
+    await streamAnthropic(args);
+  } else {
+    await streamOpenAI(args);
+  }
+  return output;
+}
+
+async function runAgent(text) {
+  const cfg = getProviderConfig();
+  const key = getKey(cfg.provider);
+  if (!isAiConfigured()) {
+    showSettings(false);
+    addUserMessage(text.trim());
+    dom.input.value = "";
+    autoGrowInput();
+    const view = createAssistantView();
+    view.status.hidden = true;
+    renderSetupCard(view);
+    updateWelcome();
+    return;
+  }
+  showSettings(false);
+  state.session.objectives.push(text.trim());
+
+  state.messages.push({ role: "user", content: text.trim() });
+  addUserMessage(text.trim());
+  dom.input.value = "";
+  autoGrowInput();
+
+  const assistant = { role: "assistant", content: "" };
+  const view = createAssistantView({ withReasoning: true });
+  view.status.hidden = true;
+  const started = performance.now();
+  let stepNo = 0;
+  state.abortController = new AbortController();
+  const signal = state.abortController.signal;
+  setStreaming(true);
+  const system = buildSystemPrompt(true);
+  startStatusRotation(view);
+
+  try {
+    const history = state.messages.slice(-24);
+    const initialPage = await collectPageContext();
+    if (initialPage) {
+      stepNo += 1;
+      beginWalkStep(view, { n: stepNo, title: "Reading the active page" });
+      const round = {
+        n: stepNo,
+        thought: "Initial reconnaissance of the active page.",
+        action: { type: "read" },
+        result: { ok: true },
+        url: initialPage.url,
+        title: initialPage.title,
+      };
+      state.session.steps.push(round);
+      markWalkStepDone(view, round, initialPage);
+    }
+    let observation = null;
+    let finished = false;
+    for (let attempt = 1; attempt <= MAX_STEPS && !finished; attempt++) {
+      const messages = observation
+        ? [...history, { role: "user", content: observation }]
+        : history;
+      stepNo += 1;
+      beginWalkStep(view, { n: stepNo, title: "Thinking…" });
+      startStatusRotation(view);
+      let live = true;
+      const raw = await completeChat({
+        cfg,
+        key,
+        messages,
+        signal,
+        system,
+        onToken: (token, full) => {
+          const thought = partialThought(full);
+          if (thought) {
+            if (live) {
+              stopStatusRotation(view);
+              live = false;
+            }
+            setLiveActivity(view, thought);
+          }
+          const answer = partialAnswer(full);
+          if (answer) {
+            view.body.innerHTML = renderMarkdown(cleanAssistantText(answer));
+          }
+          scrollChat();
+        },
+      });
+      const parsed = extractJson(raw);
+      if (!parsed || !parsed.action || parsed.action.type === "done") {
+        assistant.content = parsed?.answer || raw;
+        if (view.currentStep) {
+          if (parsed?.thought) {
+            markWalkStepDone(
+              view,
+              {
+                action: { type: "answer" },
+                thought: parsed.thought,
+                result: { ok: true },
+              },
+              null
+            );
+          } else {
+            view.currentStep.el.remove();
+            view.currentStep = null;
+            stepNo -= 1;
+          }
+        }
+        finished = true;
+        break;
+      }
+      setLiveActivity(view, liveActionLabel(parsed.action));
+      const stepRecord = {
+        n: stepNo,
+        thought: parsed.thought || "",
+        action: parsed.action,
+        result: null,
+        url: "",
+        title: "",
+      };
+      const result = await executeAction(parsed.action);
+      await sleep(900);
+      const page = await collectPageContext();
+      stepRecord.result = result;
+      stepRecord.url = page?.url || "";
+      stepRecord.title = page?.title || "";
+      state.session.steps.push(stepRecord);
+      markWalkStepDone(view, stepRecord, page);
+      if (page?.text) {
+        captureFlags(page.text, page.url);
+      }
+      observation = [
+        `[Observation after step ${stepNo}]`,
+        `Action: ${JSON.stringify(parsed.action)}`,
+        `Result: ${JSON.stringify(result)}`,
+        page
+          ? `URL: ${page.url}\nTITLE: ${page.title}\n\nTEXT:\n${page.text}\n\nCONTROLS:\n${JSON.stringify(page.controls)}`
+          : "No page context available.",
+      ].join("\n");
+      history.push({ role: "assistant", content: raw });
+    }
+    if (!assistant.content) {
+      assistant.content = finished
+        ? "Done."
+        : "_Stopped after reaching the step limit._";
+    }
+    assistant.content = cleanAssistantText(assistant.content) || "Task complete.";
+    captureFlags(assistant.content, getActiveTabInfo().url);
+    view.body.innerHTML = renderMarkdown(assistant.content);
+    view.timing = formatTiming(performance.now() - started);
+    finalizeReasoning(view, performance.now() - started, stepNo);
+    attachAssistantActions(view, { text: assistant.content });
+  } catch (error) {
+    stopStatusRotation(view);
+    if (error.name === "AbortError") {
+      assistant.content = "_[stopped]_";
+    } else {
+      assistant.content = friendlyError(error);
+    }
+    view.body.innerHTML = renderMarkdown(assistant.content);
+    view.timing = formatTiming(performance.now() - started);
+    finalizeReasoning(view, performance.now() - started, stepNo, true);
+    attachAssistantActions(view, {
+      text: assistant.content,
+      allowRegenerate: false,
+    });
+    if (keyErrorNeedsSettings(error)) {
+      view.actions?.prepend(
+        actionButton("Open AI settings", () => showSettings(true))
+      );
+    }
+  } finally {
+    state.messages.push(assistant);
+    setStreaming(false);
+    state.abortController = null;
+    state.session.lastAnswer = assistant.content;
+    scheduleReport();
+    scrollChat();
+  }
+}
