diff --git a/browser/components/nullsec/NullSecStore.sys.mjs b/browser/components/nullsec/NullSecStore.sys.mjs
new file mode 100644
index 00000000..f7370d24
--- /dev/null
+++ b/browser/components/nullsec/NullSecStore.sys.mjs
@@ -0,0 +1,173 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+const MAX_TRAFFIC = 800;
+const TRAFFIC_TOPICS = [
+  "http-on-examine-response",
+  "http-on-examine-cached-response",
+  "http-on-examine-merged-response",
+];
+
+const listeners = new Set();
+const flagValues = new Set();
+
+let traffic = [];
+let flags = [];
+let reports = [];
+let trafficSeq = 0;
+let paused = false;
+let observer = null;
+
+function emit(type, detail) {
+  for (const listener of listeners) {
+    try {
+      listener(type, detail);
+    } catch (error) {
+      console.error("NullSecStore listener failed", error);
+    }
+  }
+}
+
+const trafficObserver = {
+  observe(subject, topic) {
+    if (paused) {
+      return;
+    }
+    let channel;
+    try {
+      channel = subject.QueryInterface(Ci.nsIHttpChannel);
+    } catch {
+      return;
+    }
+    let url = "";
+    try {
+      url = channel.URI?.spec || "";
+    } catch {
+      return;
+    }
+    if (!/^https?:/i.test(url)) {
+      return;
+    }
+    let entry;
+    try {
+      entry = {
+        id: ++trafficSeq,
+        ts: Date.now(),
+        method: channel.requestMethod || "GET",
+        url,
+        status: channel.responseStatus || 0,
+        statusText: channel.responseStatusText || "",
+        type: channel.getResponseHeader("content-type") || "",
+        size: channel.contentLength,
+        reqHeaders: {},
+        headers: {},
+        cached: topic === "http-on-examine-cached-response",
+      };
+      channel.visitRequestHeaders({
+        visitHeader(name, value) {
+          entry.reqHeaders[name] = value;
+        },
+      });
+      channel.visitResponseHeaders({
+        visitHeader(name, value) {
+          entry.headers[name] = value;
+        },
+      });
+    } catch {
+      return;
+    }
+    traffic.unshift(entry);
+    if (traffic.length > MAX_TRAFFIC) {
+      traffic.length = MAX_TRAFFIC;
+    }
+    emit("traffic", entry);
+  },
+};
+
+function ensureObserver() {
+  if (observer) {
+    return;
+  }
+  observer = trafficObserver;
+  for (const topic of TRAFFIC_TOPICS) {
+    Services.obs.addObserver(observer, topic);
+  }
+}
+
+ensureObserver();
+
+export function subscribe(listener) {
+  listeners.add(listener);
+  return () => listeners.delete(listener);
+}
+
+export function getTraffic() {
+  return traffic;
+}
+
+export function clearTraffic() {
+  traffic = [];
+  emit("clear");
+}
+
+export function getFlags() {
+  return flags;
+}
+
+export function addFlag(value, url = "", note = "") {
+  const flag = String(value || "").trim();
+  if (!flag || flagValues.has(flag)) {
+    return null;
+  }
+  flagValues.add(flag);
+  const entry = {
+    id: flagValues.size,
+    value: flag,
+    url,
+    note: String(note || "").trim(),
+    ts: Date.now(),
+  };
+  flags.unshift(entry);
+  emit("flags", entry);
+  return entry;
+}
+
+export function isPaused() {
+  return paused;
+}
+
+export function setPaused(value) {
+  paused = !!value;
+  emit("paused", paused);
+}
+
+export function getReports() {
+  return reports;
+}
+
+export function setReport(report) {
+  if (!report || !report.id) {
+    return;
+  }
+  const index = reports.findIndex(entry => entry.id === report.id);
+  if (index >= 0) {
+    reports[index] = report;
+  } else {
+    reports.unshift(report);
+    if (reports.length > 50) {
+      reports.length = 50;
+    }
+  }
+  emit("reports", report);
+}
+
+export function removeReport(id) {
+  reports = reports.filter(entry => entry.id !== id);
+  emit("reports", null);
+}
+
+export function clearReports() {
+  reports = [];
+  emit("reports", null);
+}
