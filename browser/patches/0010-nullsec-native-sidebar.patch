+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+const { SKILLS_CATALOG } = ChromeUtils.importESModule(
+  "moz-src:///browser/components/nullsec/SkillsCatalog.sys.mjs"
+);
+
+const moduleCache = {};
+
+function loadModule(url, name) {
+  try {
+    return ChromeUtils.importESModule(url)[name];
+  } catch (error) {
+    console.error("NullSec skills: failed to load", url, error);
+    return {};
+  }
+}
+
+function sourceModules(source) {
+  if (moduleCache[source]) {
+    return moduleCache[source];
+  }
+  let maps = [];
+  if (source === "mitre") {
+    maps = [
+      loadModule(
+        "moz-src:///browser/components/nullsec/SkillsMitreEnterprise.sys.mjs",
+        "SKILLS_MITRE_ENTERPRISE"
+      ),
+      loadModule(
+        "moz-src:///browser/components/nullsec/SkillsMitreMobile.sys.mjs",
+        "SKILLS_MITRE_MOBILE"
+      ),
+      loadModule(
+        "moz-src:///browser/components/nullsec/SkillsMitreIcs.sys.mjs",
+        "SKILLS_MITRE_ICS"
+      ),
+    ];
+  } else if (source === "owasp") {
+    maps = [
+      loadModule(
+        "moz-src:///browser/components/nullsec/SkillsOwasp.sys.mjs",
+        "SKILLS_OWASP"
+      ),
+    ];
+  } else if (source === "isecom") {
