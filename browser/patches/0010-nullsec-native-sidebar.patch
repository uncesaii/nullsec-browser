+async function streamOpenAI({ cfg, key, messages, signal, onToken, system }) {
+  const response = await fetch(apiUrl(cfg.baseurl, "/chat/completions"), {
+    method: "POST",
+    signal,
+    headers: {
+      "Content-Type": "application/json",
+      Authorization: `Bearer ${key}`,
+    },
+    body: JSON.stringify({
+      model: cfg.model,
+      stream: true,
+      temperature: Number(cfg.temperature) || 0,
+      messages: [
+        { role: "system", content: system ?? buildSystemPrompt() },
+        ...messages,
+      ],
+    }),
+  });
+  if (!response.ok) {
+    throw new Error(`${response.status} ${await response.text()}`);
+  }
+  await readSSE(response, data => {
+    if (data === "[DONE]") {
+      return;
+    }
+    try {
+      const parsed = JSON.parse(data);
+      const token = parsed.choices?.[0]?.delta?.content;
+      if (token) {
+        onToken(token);
+      }
+    } catch {}
+  });
+}
