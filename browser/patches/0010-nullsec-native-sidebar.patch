+  state.messages.push({ role: "user", content: trimmed });
+  addMessageElement({ role: "user", content: trimmed });
+  dom.chatInput.value = "";
+
+  const assistant = { role: "assistant", content: "" };
+  state.messages.push(assistant);
+  const body = addMessageElement(assistant, true);
+
+  state.abortController = new AbortController();
+  setStreaming(true);
+  try {
+    const history = state.messages.slice(0, -1).slice(-24);
+    const args = {
+      cfg,
+      key,
+      messages: history,
+      signal: state.abortController.signal,
+      onToken: token => {
+        assistant.content += token;
+        body.textContent = assistant.content;
+        scrollChat();
+      },
+    };
+    if (cfg.provider === "anthropic") {
+      await streamAnthropic(args);
+    } else {
+      await streamOpenAI(args);
+    }
+    body.innerHTML = renderMarkdown(assistant.content);
+  } catch (error) {
+    if (error.name === "AbortError") {
+      assistant.content += "\n\n_[stopped]_";
+      body.innerHTML = renderMarkdown(assistant.content);
+    } else {
+      assistant.content += `\n\n**Error:** ${error.message}`;
+      body.innerHTML = renderMarkdown(assistant.content);
+    }
+  } finally {
+    setStreaming(false);
+    state.abortController = null;
+    scrollChat();
+  }
+}
