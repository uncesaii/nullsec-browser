+async function executeAction(action) {
+  const win = getBrowserWindow();
+  const browser = win?.gBrowser?.selectedBrowser;
+  if (!action || !browser) {
+    return { ok: false, error: "no active tab" };
+  }
+  const principal = Services.scriptSecurityManager.getSystemPrincipal();
+  switch (action.type) {
+    case "navigate":
+      browser.loadURI(Services.io.newURI(action.url), {
+        triggeringPrincipal: principal,
+      });
+      return { ok: true, navigated: action.url };
+    case "back":
+      win.gBrowser.goBack();
+      return { ok: true };
+    case "forward":
+      win.gBrowser.goForward();
+      return { ok: true };
+    case "read":
+      return { ok: true };
+    case "flag": {
+      const value = String(action.value || "").trim();
+      if (!value) {
+        return { ok: false, error: "missing flag value" };
+      }
+      const tab = getActiveTabInfo();
+      const entry = NullSecStore.addFlag(
+        value,
+        tab.url,
+        action.note || "Recorded by NullSec"
+      );
+      return entry
+        ? { ok: true, flag: value }
+        : { ok: true, duplicate: true, flag: value };
+    }
+    case "report":
+      generateReport({ open: true });
+      return { ok: true, report: true };
+    case "click":
+    case "type":
+    case "scroll": {
+      const actor = pageActor();
+      if (!actor) {
+        return { ok: false, error: "page actor unavailable" };
+      }
+      if (action.type === "click") {
+        return actor.sendQuery("NullSec:click", {
+          selector: action.selector,
+        });
+      }
+      if (action.type === "type") {
+        return actor.sendQuery("NullSec:type", {
+          selector: action.selector,
+          text: action.text,
+          submit: action.submit,
+        });
+      }
+      return actor.sendQuery("NullSec:scroll", { y: action.y });
+    }
+    default:
+      return { ok: false, error: `unknown action: ${action.type}` };
+  }
