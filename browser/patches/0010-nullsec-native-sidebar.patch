+  if (clean.endsWith("/v1")) {
+    return `${clean}/messages`;
+  }
+  return `${clean}/v1/messages`;
+}
+
+const keyCache = new Map();
+
+function keyStore() {
+  return Cc["@mozilla.org/security/oskeystore;1"].getService(
+    Ci.nsIOSKeyStore
+  );
+}
+
+async function refreshKeys() {
+  keyCache.clear();
+  const store = keyStore();
+  for (const provider of Object.keys(PROVIDER_DEFAULTS)) {
+    const encrypted = Services.prefs.getStringPref(
+      KEY_PREF_PREFIX + provider,
+      ""
+    );
+    if (!encrypted) {
+      continue;
+    }
+    try {
+      const bytes = await store.asyncDecryptBytes(
+        KEY_LABEL_PREFIX + provider,
+        encrypted
+      );
+      keyCache.set(provider, new TextDecoder().decode(new Uint8Array(bytes)));
+    } catch (error) {
+      console.error("NullSec: failed to decrypt key for", provider, error);
+    }
+  }
+}
+
+function getKey(provider) {
+  return keyCache.get(provider) || "";
+}
+
+async function setKey(provider, key) {
+  const store = keyStore();
+  const prefName = KEY_PREF_PREFIX + provider;
+  const label = KEY_LABEL_PREFIX + provider;
+  try {
+    if (!key) {
+      Services.prefs.clearUserPref(prefName);
+      await store.asyncDeleteSecret(label);
+      keyCache.delete(provider);
+      return true;
+    }
+    if (!(await store.asyncSecretAvailable(label))) {
+      await store.asyncGenerateSecret(label);
+    }
+    const encrypted = await store.asyncEncryptBytes(
+      label,
+      new TextEncoder().encode(key)
+    );
+    Services.prefs.setStringPref(prefName, encrypted);
+    keyCache.set(provider, key);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
