+    case "type":
+      return `Typing into ${action.selector}`;
+    case "navigate":
+      return `Navigating to ${action.url}`;
+    case "scroll":
+      return `Scrolling by ${action.y || 600}px`;
+    case "back":
+      return "Going back";
+    case "forward":
+      return "Going forward";
+    case "read":
+      return "Reading the page";
+    case "flag":
+      return `Recording flag ${action.value}`;
+    case "report":
+      return "Generating the engagement report";
+    default:
+      return `Action: ${action.type}`;
+  }
