diff --git a/browser/components/nullsec/NullSecStore.sys.mjs b/browser/components/nullsec/NullSecStore.sys.mjs
new file mode 100644
index 00000000..f7370d24
--- /dev/null
+++ b/browser/components/nullsec/NullSecStore.sys.mjs
@@ -0,0 +1,173 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+const MAX_TRAFFIC = 800;
+const TRAFFIC_TOPICS = [
+  "http-on-examine-response",
+  "http-on-examine-cached-response",
+  "http-on-examine-merged-response",
+];
+
+const listeners = new Set();
+const flagValues = new Set();
+
+let traffic = [];
+let flags = [];
+let reports = [];
+let trafficSeq = 0;
+let paused = false;
+let observer = null;
+
+function emit(type, detail) {
+  for (const listener of listeners) {
+    try {
+      listener(type, detail);
+    } catch (error) {
+      console.error("NullSecStore listener failed", error);
+    }
+  }
+}
+
+const trafficObserver = {
+  observe(subject, topic) {
+    if (paused) {
+      return;
+    }
+    let channel;
+    try {
+      channel = subject.QueryInterface(Ci.nsIHttpChannel);
+    } catch {
+      return;
+    }
+    let url = "";
+    try {
+      url = channel.URI?.spec || "";
+    } catch {
+      return;
+    }
+    if (!/^https?:/i.test(url)) {
+      return;
+    }
+    let entry;
+    try {
+      entry = {
+        id: ++trafficSeq,
+        ts: Date.now(),
+        method: channel.requestMethod || "GET",
+        url,
+        status: channel.responseStatus || 0,
+        statusText: channel.responseStatusText || "",
+        type: channel.getResponseHeader("content-type") || "",
+        size: channel.contentLength,
+        reqHeaders: {},
+        headers: {},
+        cached: topic === "http-on-examine-cached-response",
+      };
+      channel.visitRequestHeaders({
+        visitHeader(name, value) {
+          entry.reqHeaders[name] = value;
+        },
+      });
+      channel.visitResponseHeaders({
+        visitHeader(name, value) {
+          entry.headers[name] = value;
+        },
+      });
+    } catch {
+      return;
+    }
+    traffic.unshift(entry);
+    if (traffic.length > MAX_TRAFFIC) {
+      traffic.length = MAX_TRAFFIC;
+    }
+    emit("traffic", entry);
+  },
+};
+
+function ensureObserver() {
+  if (observer) {
+    return;
+  }
+  observer = trafficObserver;
+  for (const topic of TRAFFIC_TOPICS) {
+    Services.obs.addObserver(observer, topic);
+  }
+}
+
+ensureObserver();
+
+export function subscribe(listener) {
+  listeners.add(listener);
+  return () => listeners.delete(listener);
+}
+
+export function getTraffic() {
+  return traffic;
+}
+
+export function clearTraffic() {
+  traffic = [];
+  emit("clear");
+}
+
+export function getFlags() {
+  return flags;
+}
+
+export function addFlag(value, url = "", note = "") {
+  const flag = String(value || "").trim();
+  if (!flag || flagValues.has(flag)) {
+    return null;
+  }
+  flagValues.add(flag);
+  const entry = {
+    id: flagValues.size,
+    value: flag,
+    url,
+    note: String(note || "").trim(),
+    ts: Date.now(),
+  };
+  flags.unshift(entry);
+  emit("flags", entry);
+  return entry;
+}
+
+export function isPaused() {
+  return paused;
+}
+
+export function setPaused(value) {
+  paused = !!value;
+  emit("paused", paused);
+}
+
+export function getReports() {
+  return reports;
+}
+
+export function setReport(report) {
+  if (!report || !report.id) {
+    return;
+  }
+  const index = reports.findIndex(entry => entry.id === report.id);
+  if (index >= 0) {
+    reports[index] = report;
+  } else {
+    reports.unshift(report);
+    if (reports.length > 50) {
+      reports.length = 50;
+    }
+  }
+  emit("reports", report);
+}
+
+export function removeReport(id) {
+  reports = reports.filter(entry => entry.id !== id);
+  emit("reports", null);
+}
+
+export function clearReports() {
+  reports = [];
+  emit("reports", null);
+}
diff --git a/browser/components/nullsec/Skills.sys.mjs b/browser/components/nullsec/Skills.sys.mjs
new file mode 100644
index 00000000..63a05951
--- /dev/null
+++ b/browser/components/nullsec/Skills.sys.mjs
@@ -0,0 +1,107 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+const { SKILLS_CATALOG } = ChromeUtils.importESModule(
+  "moz-src:///browser/components/nullsec/SkillsCatalog.sys.mjs"
+);
+
+const moduleCache = {};
+
+function loadModule(url, name) {
+  try {
+    return ChromeUtils.importESModule(url)[name];
+  } catch (error) {
+    console.error("NullSec skills: failed to load", url, error);
+    return {};
+  }
+}
+
+function sourceModules(source) {
+  if (moduleCache[source]) {
+    return moduleCache[source];
+  }
+  let maps = [];
+  if (source === "mitre") {
+    maps = [
+      loadModule(
+        "moz-src:///browser/components/nullsec/SkillsMitreEnterprise.sys.mjs",
+        "SKILLS_MITRE_ENTERPRISE"
+      ),
+      loadModule(
+        "moz-src:///browser/components/nullsec/SkillsMitreMobile.sys.mjs",
+        "SKILLS_MITRE_MOBILE"
+      ),
+      loadModule(
+        "moz-src:///browser/components/nullsec/SkillsMitreIcs.sys.mjs",
+        "SKILLS_MITRE_ICS"
+      ),
+    ];
+  } else if (source === "owasp") {
+    maps = [
+      loadModule(
+        "moz-src:///browser/components/nullsec/SkillsOwasp.sys.mjs",
+        "SKILLS_OWASP"
+      ),
+    ];
+  } else if (source === "isecom") {
+    maps = [
+      loadModule(
+        "moz-src:///browser/components/nullsec/SkillsIsecom.sys.mjs",
+        "SKILLS_ISECOM"
+      ),
+    ];
+  }
+  moduleCache[source] = maps;
+  return maps;
+}
+
+export function count() {
+  return SKILLS_CATALOG.length;
+}
+
+export function search(query, limit = 8) {
+  const terms = String(query || "")
+    .toLowerCase()
+    .split(/[^a-z0-9]+/)
+    .filter(term => term.length > 2);
+  if (!terms.length) {
+    return [];
+  }
+  const scored = [];
+  for (const entry of SKILLS_CATALOG) {
+    const haystack = `${entry.title} ${entry.tags.join(" ")} ${entry.summary}`.toLowerCase();
+    let score = 0;
+    for (const term of terms) {
+      if (haystack.includes(term)) {
+        score += entry.tags.includes(term) ? 2 : 1;
+      }
+    }
+    if (score > 0) {
+      scored.push({ entry, score });
+    }
+  }
+  scored.sort((a, b) => b.score - a.score);
+  return scored.slice(0, limit).map(item => item.entry);
+}
+
+export function get(id) {
+  const entry = SKILLS_CATALOG.find(item => item.id === id);
+  if (!entry) {
+    return null;
+  }
+  for (const map of sourceModules(entry.source)) {
+    if (map && map[id]) {
+      return { ...entry, content: map[id] };
+    }
+  }
+  return null;
+}
+
+export function sources() {
+  const map = {};
+  for (const entry of SKILLS_CATALOG) {
+    map[entry.source] = (map[entry.source] || 0) + 1;
+  }
+  return map;
+}
