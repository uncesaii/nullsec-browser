+  dom.input.value = "";
+
+  const assistant = { role: "assistant", content: "" };
+  state.messages.push(assistant);
+  const body = addMessageElement(assistant, true);
+
+  state.abortController = new AbortController();
+  setStreaming(true);
+  try {
+    const history = state.messages.slice(0, -1).slice(-24);
+    const args = {
+      cfg,
+      key,
+      messages: history,
+      signal: state.abortController.signal,
+      onToken: token => {
+        assistant.content += token;
+        body.textContent = assistant.content;
+        scrollChat();
+      },
+    };
+    if (cfg.provider === "anthropic") {
+      await streamAnthropic(args);
+    } else {
+      await streamOpenAI(args);
+    }
+    body.innerHTML = renderMarkdown(assistant.content);
+    captureFlags(assistant.content, getActiveTabInfo().url);
+  } catch (error) {
+    if (error.name === "AbortError") {
+      assistant.content += "\n\n_[stopped]_";
+      body.innerHTML = renderMarkdown(assistant.content);
+    } else {
+      assistant.content += `\n\n**Error:** ${error.message}`;
+      body.innerHTML = renderMarkdown(assistant.content);
+    }
+  } finally {
+    setStreaming(false);
+    state.abortController = null;
+    scrollChat();
+  }
+}
+
+function getBoolPref(name, fallback) {
+  try {
+    return Services.prefs.getBoolPref(name, fallback);
+  } catch {
+    return fallback;
+  }
+}
+
+function sleep(ms) {
+  return new Promise(resolve => setTimeout(resolve, ms));
+}
+
+function pageActor() {
+  const win = getBrowserWindow();
+  const browsingContext = win?.gBrowser?.selectedBrowser?.browsingContext;
+  const global = browsingContext?.currentWindowGlobal;
+  if (!global) {
+    return null;
+  }
+  try {
+    return global.getActor("NullSec") || null;
+  } catch {
+    return null;
+  }
+}
+
+async function collectPageContext() {
+  for (let attempt = 0; attempt < 3; attempt++) {
+    const actor = pageActor();
+    if (actor) {
+      try {
+        return await actor.sendQuery("NullSec:read");
+      } catch {}
+    }
+    await sleep(700);
+  }
+  return null;
+}
+
+async function executeAction(action) {
+  const win = getBrowserWindow();
+  const browser = win?.gBrowser?.selectedBrowser;
+  if (!action || !browser) {
+    return { ok: false, error: "no active tab" };
+  }
+  const principal = Services.scriptSecurityManager.getSystemPrincipal();
+  switch (action.type) {
+    case "navigate":
+      browser.loadURI(Services.io.newURI(action.url), {
+        triggeringPrincipal: principal,
+      });
+      return { ok: true, navigated: action.url };
+    case "back":
+      win.gBrowser.goBack();
+      return { ok: true };
+    case "forward":
+      win.gBrowser.goForward();
+      return { ok: true };
+    case "read":
+      return { ok: true };
+    case "flag": {
+      const value = String(action.value || "").trim();
+      if (!value) {
+        return { ok: false, error: "missing flag value" };
+      }
+      const tab = getActiveTabInfo();
+      const entry = NullSecStore.addFlag(
+        value,
+        tab.url,
+        action.note || "Recorded by NullSec"
+      );
+      return entry
+        ? { ok: true, flag: value }
+        : { ok: true, duplicate: true, flag: value };
+    }
+    case "click":
+    case "type":
+    case "scroll": {
+      const actor = pageActor();
+      if (!actor) {
+        return { ok: false, error: "page actor unavailable" };
+      }
+      if (action.type === "click") {
+        return actor.sendQuery("NullSec:click", {
+          selector: action.selector,
+        });
+      }
+      if (action.type === "type") {
+        return actor.sendQuery("NullSec:type", {
+          selector: action.selector,
+          text: action.text,
+          submit: action.submit,
+        });
+      }
+      return actor.sendQuery("NullSec:scroll", { y: action.y });
+    }
+    default:
+      return { ok: false, error: `unknown action: ${action.type}` };
+  }
+}
+
+function extractJson(text) {
+  const source = String(text);
+  const candidates = [];
+  const fence = source.match(/```(?:json)?\s*([\s\S]*?)```/i);
+  if (fence) {
+    candidates.push(fence[1]);
+  }
+  const start = source.indexOf("{");
+  const end = source.lastIndexOf("}");
+  if (start >= 0 && end > start) {
+    candidates.push(source.slice(start, end + 1));
+  }
+  for (const candidate of candidates) {
+    try {
+      const parsed = JSON.parse(candidate);
+      if (parsed && typeof parsed === "object") {
+        return parsed;
+      }
+    } catch {}
+  }
+  return null;
+}
+
+function describeAction(action) {
+  switch (action.type) {
+    case "click":
+      return `Clicking ${action.selector}`;
+    case "type":
+      return `Typing into ${action.selector}`;
+    case "navigate":
+      return `Navigating to ${action.url}`;
+    case "scroll":
+      return `Scrolling by ${action.y || 600}px`;
+    case "back":
+      return "Going back";
+    case "forward":
+      return "Going forward";
+    case "read":
+      return "Reading the page";
+    case "flag":
+      return `Recording flag ${action.value}`;
+    default:
+      return `Action: ${action.type}`;
+  }
+}
+
+function addStepElement(text) {
+  dom.empty.hidden = true;
+  const node = document.createElement("div");
+  node.className = "step";
+  node.textContent = text;
+  dom.messages.appendChild(node);
+  scrollChat();
+}
+
+function captureFlags(text, url = "") {
+  if (!text) {
+    return;
+  }
+  const matches = String(text).match(FLAG_PATTERN) || [];
+  for (const value of matches) {
+    NullSecStore.addFlag(value, url, "Detected in page or model output");
+  }
+}
+
+async function completeChat({ cfg, key, messages, signal, system }) {
+  let output = "";
+  const args = {
+    cfg,
+    key,
+    messages,
+    signal,
+    system,
+    onToken: token => {
+      output += token;
+    },
+  };
+  if (cfg.provider === "anthropic") {
+    await streamAnthropic(args);
+  } else {
+    await streamOpenAI(args);
+  }
+  return output;
+}
+
+async function runAgent(text) {
+  const cfg = getProviderConfig();
+  const key = getKey(cfg.provider);
+  if (!key && cfg.provider !== "compatible") {
+    dom.settings.hidden = false;
+    dom.status.textContent = "Add an API key for this provider.";
+    return;
+  }
+  dom.settings.hidden = true;
+
+  state.messages.push({ role: "user", content: text.trim() });
+  addMessageElement({ role: "user", content: text.trim() });
+  dom.input.value = "";
+
+  const assistant = { role: "assistant", content: "" };
+  const body = addMessageElement(assistant, true);
+  body.textContent = "Working...";
+  state.abortController = new AbortController();
+  const signal = state.abortController.signal;
+  setStreaming(true);
+  const system = buildSystemPrompt(true);
+
+  try {
+    const history = state.messages.slice(-24);
+    let observation = null;
+    let finished = false;
+    for (let step = 1; step <= MAX_STEPS && !finished; step++) {
+      const messages = observation
+        ? [...history, { role: "user", content: observation }]
+        : history;
+      const raw = await completeChat({ cfg, key, messages, signal, system });
+      const parsed = extractJson(raw);
+      if (!parsed || !parsed.action || parsed.action.type === "done") {
+        assistant.content = parsed?.answer || raw;
+        finished = true;
+        break;
+      }
+      addStepElement(`Step ${step}: ${describeAction(parsed.action)}`);
+      const result = await executeAction(parsed.action);
+      await sleep(900);
+      const page = await collectPageContext();
+      if (page?.text) {
+        captureFlags(page.text, page.url);
+      }
+      observation = [
+        `[Observation after step ${step}]`,
+        `Action: ${JSON.stringify(parsed.action)}`,
+        `Result: ${JSON.stringify(result)}`,
+        page
+          ? `URL: ${page.url}\nTITLE: ${page.title}\n\nTEXT:\n${page.text}\n\nCONTROLS:\n${JSON.stringify(page.controls)}`
+          : "No page context available.",
+      ].join("\n");
+      history.push({ role: "assistant", content: raw });
+    }
+    if (!assistant.content) {
+      assistant.content = finished
+        ? "Done."
+        : "_Stopped after reaching the step limit._";
+    }
+    captureFlags(assistant.content, getActiveTabInfo().url);
+    body.innerHTML = renderMarkdown(assistant.content);
+  } catch (error) {
+    if (error.name === "AbortError") {
+      assistant.content = "_[stopped]_";
+      body.innerHTML = renderMarkdown(assistant.content);
+    } else {
+      assistant.content = `**Error:** ${error.message}`;
+      body.innerHTML = renderMarkdown(assistant.content);
+    }
+  } finally {
+    state.messages.push(assistant);
+    setStreaming(false);
+    state.abortController = null;
+    scrollChat();
+  }
+}
+
+function buildReportMarkdown() {
+  const now = new Date();
+  const flags = NullSecStore.getFlags();
+  const traffic = NullSecStore.getTraffic();
+  const tab = getActiveTabInfo();
+  const lines = [];
+  lines.push("# NullSec Engagement Report");
+  lines.push("");
+  lines.push(`_Generated ${now.toISOString()}_`);
+  lines.push("");
+  lines.push("## Summary");
+  lines.push("");
+  lines.push(`- Active tab: ${tab.url || "none"}`);
+  lines.push(`- Flags recovered: ${flags.length}`);
+  lines.push(`- Requests captured this session: ${traffic.length}`);
+  lines.push("");
+  lines.push("## Flags");
+  lines.push("");
+  if (!flags.length) {
+    lines.push("_No flags recorded._");
+  } else {
+    lines.push("| Flag | Source | Note |");
+    lines.push("| --- | --- | --- |");
+    for (const flag of flags) {
+      lines.push(
+        `| \`${flag.value}\` | ${flag.url || "-"} | ${flag.note || "-"} |`
+      );
+    }
+  }
+  lines.push("");
+  lines.push("## Captured Requests");
+  lines.push("");
+  if (!traffic.length) {
+    lines.push("_No requests captured during this session._");
+  } else {
+    lines.push("| Method | URL | Status | Type |");
+    lines.push("| --- | --- | --- | --- |");
+    for (const entry of traffic.slice(-100)) {
+      lines.push(
+        `| ${entry.method} | ${entry.url} | ${entry.status || "-"} | ${entry.type || "-"} |`
+      );
+    }
+  }
+  lines.push("");
+  lines.push("---");
+  lines.push("_Prepared with NullSec. For authorized engagements only._");
+  return lines.join("\n");
+}
+
+function generateReport() {
+  dom.settings.hidden = true;
+  const markdown = buildReportMarkdown();
+  const wrapper = document.createElement("div");
+  wrapper.className = "message is-assistant";
+  const role = document.createElement("div");
+  role.className = "message-role";
+  role.textContent = "Flag report";
+  const report = document.createElement("div");
+  report.className = "message-body report";
+  report.innerHTML = renderMarkdown(markdown);
+  const actions = document.createElement("div");
+  actions.className = "report-actions";
+  const copy = document.createElement("moz-button");
+  copy.setAttribute("type", "ghost");
+  copy.textContent = "Copy";
+  copy.addEventListener("click", () => {
+    copyText(markdown);
+    copy.textContent = "Copied";
+    setTimeout(() => (copy.textContent = "Copy"), 1500);
+  });
+  const save = document.createElement("moz-button");
+  save.setAttribute("type", "ghost");
+  save.textContent = "Save .md";
+  save.addEventListener("click", async () => {
+    try {
+      const path = PathUtils.join(REPORT_DIR(), "nullsec-report.md");
+      await IOUtils.makeDirectory(REPORT_DIR(), { ignoreExisting: true });
+      await IOUtils.writeUTF8(path, markdown);
+      save.textContent = "Saved";
+      save.title = path;
+      setTimeout(() => (save.textContent = "Save .md"), 1500);
+    } catch (error) {
+      save.textContent = "Failed";
+      save.title = error.message;
+    }
+  });
+  actions.append(copy, save);
+  wrapper.append(role, report, actions);
+  dom.empty.hidden = true;
+  dom.messages.appendChild(wrapper);
+  scrollChat();
+}
+
+function applyProviderDefaults(provider) {
+  const defaults = PROVIDER_DEFAULTS[provider];
+  if (!defaults) {
+    return;
+  }
+  dom.baseurl.value = defaults.baseurl;
+  dom.model.value = defaults.model;
+}
+
+function loadSettingsIntoUI() {
+  const cfg = getProviderConfig();
+  dom.provider.value = cfg.provider;
+  dom.baseurl.value = cfg.baseurl;
+  dom.model.value = cfg.model;
+  dom.temp.value = cfg.temperature;
+  dom.system.value = cfg.system;
+  const key = getKey(cfg.provider);
+  dom.key.value = "";
+  dom.key.placeholder = key
+    ? "Stored with OS encryption (enter to replace)"
+    : "Stored with OS encryption";
+  dom.autopilot.pressed = getBoolPref(PREF.autopilot, false);
+  dom.pageContext.pressed = getBoolPref(PREF.pageContext, true);
+}
+
+async function saveSettingsFromUI() {
+  const provider = dom.provider.value;
+  const defaults = PROVIDER_DEFAULTS[provider] || PROVIDER_DEFAULTS.openai;
+  const baseurl = dom.baseurl.value.trim() || defaults.baseurl;
+  const model = dom.model.value.trim() || defaults.model;
+  const rawTemp = dom.temp.value;
+  const parsedTemp = Number(rawTemp);
+  const temperature =
+    rawTemp === "" || rawTemp == null || Number.isNaN(parsedTemp)
+      ? "0.3"
+      : String(parsedTemp);
+  const system = dom.system.value.trim();
+  Services.prefs.setStringPref(PREF.provider, provider);
+  Services.prefs.setStringPref(PREF.baseurl, baseurl);
+  Services.prefs.setStringPref(PREF.model, model);
+  Services.prefs.setStringPref(PREF.temperature, temperature);
+  Services.prefs.setStringPref(PREF.system, system);
+  Services.prefs.setBoolPref(PREF.autopilot, dom.autopilot.pressed);
+  Services.prefs.setBoolPref(PREF.pageContext, dom.pageContext.pressed);
+  let message = "Saved.";
+  if (dom.key.value) {
+    const stored = await setKey(provider, dom.key.value);
+    message = stored
+      ? "Saved. API key stored with OS encryption."
+      : "Settings saved, but the API key could not be stored.";
+    dom.key.value = "";
+  }
+  loadSettingsIntoUI();
+  dom.status.textContent = message;
+}
+
+function initChrome() {
+  dom.provider = $("header-provider");
+  dom.traffic = $("header-traffic");
+  dom.settingsButton = $("header-settings");
+  dom.close = $("header-close");
+  dom.contextTitle = $("ai-context-title");
+  dom.contextUrl = $("ai-context-url");
+  dom.settings = $("settings");
+  dom.baseurl = $("ai-baseurl");
+  dom.model = $("ai-model");
+  dom.key = $("ai-key");
+  dom.temp = $("ai-temp");
+  dom.system = $("ai-system");
+  dom.autopilot = $("ai-autopilot");
+  dom.pageContext = $("ai-page-context");
+  dom.status = $("ai-status");
+  dom.save = $("ai-save");
+  dom.clearKey = $("ai-clear-key");
+  dom.messageContainer = $("message-container");
+  dom.messages = $("chat-messages");
+  dom.empty = $("chat-empty");
+  dom.input = $("chat-input");
+  dom.send = $("chat-send");
+  dom.stop = $("chat-stop");
+  dom.report = $("chip-report");
+
+  dom.close.addEventListener("click", () => {
+    getBrowserWindow()?.SidebarController?.hide();
+  });
+  dom.traffic.addEventListener("click", () => {
+    getBrowserWindow()?.SidebarController?.show("viewNullSecTrafficSidebar");
+  });
+  dom.settingsButton.addEventListener("click", () => {
+    dom.settings.hidden = !dom.settings.hidden;
+  });
+
+  dom.provider.addEventListener("change", () => {
+    const provider = dom.provider.value;
+    Services.prefs.setStringPref(PREF.provider, provider);
+    applyProviderDefaults(provider);
+    const defaults = PROVIDER_DEFAULTS[provider];
+    if (defaults) {
+      Services.prefs.setStringPref(PREF.baseurl, defaults.baseurl);
+      Services.prefs.setStringPref(PREF.model, defaults.model);
+    }
+    loadSettingsIntoUI();
+  });
+
+  dom.autopilot.addEventListener("toggle", () => {
+    Services.prefs.setBoolPref(PREF.autopilot, dom.autopilot.pressed);
+  });
+  dom.pageContext.addEventListener("toggle", () => {
+    Services.prefs.setBoolPref(PREF.pageContext, dom.pageContext.pressed);
+  });
+
+  dom.send.addEventListener("click", () => sendChat(dom.input.value));
+  dom.input.addEventListener("keydown", event => {
+    if (event.key === "Enter" && !event.shiftKey) {
+      event.preventDefault();
+      sendChat(dom.input.value);
+    }
+  });
+  dom.stop.addEventListener("click", () => {
+    state.abortController?.abort();
+  });
+  dom.report.addEventListener("click", generateReport);
+  dom.save.addEventListener("click", saveSettingsFromUI);
+  dom.clearKey.addEventListener("click", async () => {
+    const provider = dom.provider.value;
+    const removed = await setKey(provider, "");
+    loadSettingsIntoUI();
+    dom.status.textContent = removed
+      ? "API key removed."
+      : "Could not remove API key.";
+  });
+
+  const win = getBrowserWindow();
+  if (win?.gBrowser) {
+    win.gBrowser.tabContainer.addEventListener("TabSelect", updateContext);
+    win.gBrowser.tabContainer.addEventListener(
+      "TabAttrModified",
+      updateContext
+    );
+    window.addEventListener(
+      "unload",
+      () => {
+        win.gBrowser.tabContainer.removeEventListener(
+          "TabSelect",
+          updateContext
+        );
+        win.gBrowser.tabContainer.removeEventListener(
+          "TabAttrModified",
+          updateContext
+        );
+      },
+      { once: true }
+    );
+  }
+  const contextTimer = setInterval(updateContext, 1500);
+  window.addEventListener(
+    "unload",
+    () => clearInterval(contextTimer),
+    { once: true }
+  );
+}
+
+async function init() {
+  initChrome();
+  loadSettingsIntoUI();
+  updateContext();
+  try {
+    await refreshKeys();
+  } catch (error) {
+    console.error("NullSec: key refresh failed", error);
+  }
+  loadSettingsIntoUI();
+}
+
+init();
