diff --git a/browser/actors/NullSecChild.sys.mjs b/browser/actors/NullSecChild.sys.mjs
new file mode 100644
index 00000000..48c6f4b0
--- /dev/null
+++ b/browser/actors/NullSecChild.sys.mjs
@@ -0,0 +1,147 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+const MAX_TEXT = 20000;
+const MAX_CONTROLS = 150;
+
+export class NullSecChild extends JSWindowActorChild {
+  receiveMessage(message) {
+    switch (message.name) {
+      case "NullSec:read":
+        return this.readPage();
+      case "NullSec:click":
+        return this.click(message.data?.selector);
+      case "NullSec:type":
+        return this.typeInto(message.data || {});
+      case "NullSec:scroll":
+        return this.scroll(message.data || {});
+      default:
+        return null;
+    }
+  }
+
+  selectorFor(element) {
+    if (!element || element.nodeType !== 1) {
+      return "";
+    }
+    if (element.id) {
+      return `#${CSS.escape(element.id)}`;
+    }
+    const name = element.getAttribute("name");
+    if (name) {
+      const selector = `${element.tagName.toLowerCase()}[name="${CSS.escape(
+        name
+      )}"]`;
+      if (this.document.querySelectorAll(selector).length === 1) {
+        return selector;
+      }
+    }
+    const parts = [];
+    let node = element;
+    while (node && node.nodeType === 1 && parts.length < 6) {
+      if (node.id) {
+        parts.unshift(`#${CSS.escape(node.id)}`);
+        break;
+      }
+      let part = node.tagName.toLowerCase();
+      const parent = node.parentElement;
+      if (parent) {
+        const siblings = [...parent.children].filter(
+          child => child.tagName === node.tagName
+        );
+        if (siblings.length > 1) {
+          part += `:nth-of-type(${siblings.indexOf(node) + 1})`;
+        }
+      }
+      parts.unshift(part);
+      node = parent;
+    }
+    return parts.join(" > ");
+  }
+
+  describe(element) {
+    return {
+      tag: element.tagName.toLowerCase(),
+      type: element.getAttribute("type") || "",
+      name: element.getAttribute("name") || "",
+      label:
+        element.getAttribute("aria-label") ||
+        element.getAttribute("placeholder") ||
+        "",
+      text: String(element.innerText || element.value || "")
+        .replace(/\s+/g, " ")
+        .trim()
+        .slice(0, 80),
+      selector: this.selectorFor(element),
+    };
+  }
+
+  readPage() {
+    const doc = this.document;
+    const text = String(doc.body?.innerText || "")
+      .replace(/\n{3,}/g, "\n\n")
+      .slice(0, MAX_TEXT);
+    const controls = [];
+    for (const element of doc.querySelectorAll(
+      "a,button,input,textarea,select,[role=button]"
+    )) {
+      if (controls.length >= MAX_CONTROLS) {
+        break;
+      }
+      controls.push(this.describe(element));
+    }
+    return {
+      url: doc.location.href,
+      title: doc.title,
+      text,
+      controls,
+    };
+  }
+
+  click(selector) {
+    if (!selector) {
+      return { ok: false, error: "missing selector" };
+    }
+    const element = this.document.querySelector(selector);
+    if (!element) {
+      return { ok: false, error: `no element for ${selector}` };
+    }
+    element.scrollIntoView({ block: "center", inline: "center" });
+    element.click();
+    return { ok: true, clicked: this.describe(element) };
+  }
+
+  typeInto({ selector, text, submit }) {
+    if (!selector) {
+      return { ok: false, error: "missing selector" };
+    }
+    const element = this.document.querySelector(selector);
+    if (!element) {
+      return { ok: false, error: `no element for ${selector}` };
+    }
+    element.focus();
+    element.value = String(text ?? "");
+    const view = this.contentWindow;
+    element.dispatchEvent(new view.Event("input", { bubbles: true }));
+    element.dispatchEvent(new view.Event("change", { bubbles: true }));
+    if (submit !== false && element.form) {
+      if (element.form.requestSubmit) {
+        element.form.requestSubmit();
+      } else {
+        element.form.submit();
+      }
+    }
+    return { ok: true, typed: this.describe(element) };
+  }
+
+  scroll({ y }) {
+    const amount = Number.isFinite(y) ? y : 600;
+    this.contentWindow.scrollBy({ top: amount, behavior: "auto" });
+    return {
+      ok: true,
+      scrollY: this.contentWindow.scrollY,
+      height: this.document.documentElement.scrollHeight,
+    };
+  }
+}
