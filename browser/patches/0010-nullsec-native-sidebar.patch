+    );
+    attachAssistantActions(view, {
+      text: "Report generated.",
+      allowRegenerate: false,
+    });
+    generateReport({ open: true });
+    return;
+  }
+  if (getBoolPref(PREF.autopilot, false)) {
+    return runAgent(trimmed);
+  }
+  state.session.objectives.push(trimmed);
+  const cfg = getProviderConfig();
+  const key = getKey(cfg.provider);
+  if (!key && cfg.provider !== "compatible") {
+    showSettings(true);
+    dom.status.textContent = "Add an API key for this provider.";
+    return;
+  }
+  showSettings(false);
