+    # When cross-compiling for Windows with clang (mingw), bindgen passes the
+    # Rust "windows-gnullvm" triple to clang unchanged, which clang rejects.
+    # Use the mingw triple instead.  Also add -fms-extensions so that libclang
+    # can parse mingw headers that use __declspec, anonymous structs/unions,
+    # and other MSVC extensions (without this, bindgen's IR ends up with
+    # dangling item references that panic during layout computation).
+    if target.os == "WINNT" and compiler_info.type == "clang":
+        args += ["--target=x86_64-pc-windows-gnu", "-fms-extensions"]
+
