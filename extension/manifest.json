{
  "manifest_version": 3,
  "name": "NullSec",
  "version": "0.1.0",
  "description": "CTF workspace tools for labs, challenges, and authorized testing.",
  "browser_specific_settings": {
    "gecko": {
      "id": "nullsec@nullsec.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": ["authenticationInfo", "browsingActivity", "websiteContent"]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "cookies",
    "downloads",
    "menus",
    "nativeMessaging",
    "scripting",
    "storage",
    "tabs",
    "unlimitedStorage",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "NullSec",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "theme_icons": [
      {
        "light": "icons/theme-light-16.png",
        "dark": "icons/theme-dark-16.png",
        "size": 16
      },
      {
        "light": "icons/theme-light-32.png",
        "dark": "icons/theme-dark-32.png",
        "size": 32
      }
    ]
  },
  "sidebar_action": {
    "default_title": "NullSec",
    "default_panel": "sidebar.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "devtools_page": "devtools.html",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "Open the NullSec sidebar"
    },
    "open-dock": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Open the NullSec request dock"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}