{
  "version": 1,
  "defaultProvider": "openrouter",
  "providers": [
    {
      "id": "openrouter",
      "name": "OpenRouter",
      "protocol": "openai-chat",
      "baseUrl": "https://openrouter.ai/api/v1",
      "chatPath": "/chat/completions",
      "modelsPath": "/models",
      "auth": { "type": "bearer", "header": "Authorization", "scheme": "Bearer " },
      "defaultModel": "openrouter/auto",
      "supportsTools": true,
      "supportsStreaming": true,
      "docsUrl": "https://openrouter.ai/docs",
      "notes": "Default provider. Model slugs are fetched from /models; do not hardcode a model list."
    },
    {
      "id": "openai",
      "name": "OpenAI",
      "protocol": "openai-chat",
      "baseUrl": "https://api.openai.com/v1",
      "chatPath": "/chat/completions",
      "modelsPath": "/models",
      "auth": { "type": "bearer", "header": "Authorization", "scheme": "Bearer " },
      "defaultModel": "",
      "supportsTools": true,
      "supportsStreaming": true,
      "docsUrl": "https://platform.openai.com/docs/api-reference",
      "notes": "Use the model picker. Project-scoped keys may restrict model access."
    },
    {
      "id": "anthropic",
      "name": "Anthropic",
      "protocol": "anthropic-messages",
      "baseUrl": "https://api.anthropic.com",
      "chatPath": "/v1/messages",
      "modelsPath": "/v1/models",
      "auth": { "type": "x-api-key", "header": "x-api-key" },
      "defaultModel": "",
      "supportsTools": true,
      "supportsStreaming": true,
      "docsUrl": "https://docs.anthropic.com/en/api/messages",
      "extraHeaders": {
        "anthropic-version": "2023-06-01",
        "anthropic-dangerous-direct-browser-access": "true"
      },
      "notes": "Native Messages API adapter. The direct-browser header is required for browser-originated requests."
    },
    {
      "id": "gemini",
      "name": "Google Gemini",
      "protocol": "openai-chat",
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
      "chatPath": "/chat/completions",
      "modelsPath": "/models",
      "auth": { "type": "bearer", "header": "Authorization", "scheme": "Bearer " },
      "defaultModel": "",
      "supportsTools": true,
      "supportsStreaming": true,
      "docsUrl": "https://ai.google.dev/gemini-api/docs/openai",
      "notes": "Uses Google's OpenAI-compatible endpoint for a single tool-calling adapter. Model names drift; use the picker."
    },
    {
      "id": "deepseek",
      "name": "DeepSeek",
      "protocol": "openai-chat",
      "baseUrl": "https://api.deepseek.com",
      "chatPath": "/chat/completions",
      "modelsPath": "/models",
      "auth": { "type": "bearer", "header": "Authorization", "scheme": "Bearer " },
      "defaultModel": "deepseek-flash",
      "supportsTools": true,
      "supportsStreaming": true,
      "docsUrl": "https://api-docs.deepseek.com/",
      "notes": "OpenAI-compatible endpoint. Model names and reasoning parameters change; verify with the model picker."
    },
    {
      "id": "moonshot",
      "name": "Moonshot / Kimi",
      "protocol": "openai-chat",
      "baseUrl": "https://api.moonshot.ai/v1",
      "chatPath": "/chat/completions",
      "modelsPath": "/models",
      "auth": { "type": "bearer", "header": "Authorization", "scheme": "Bearer " },
      "defaultModel": "kimi-k3.1-pro",
      "supportsTools": true,
      "supportsStreaming": true,
      "docsUrl": "https://platform.moonshot.ai/docs/api/chat",
      "notes": "International endpoint. China endpoint differs; set a custom base URL if needed."
    },
    {
      "id": "zhipu",
      "name": "Zhipu / Z.ai",
      "protocol": "openai-chat",
      "baseUrl": "https://api.z.ai/api/paas/v4",
      "chatPath": "/chat/completions",
      "modelsPath": "/models",
      "auth": { "type": "bearer", "header": "Authorization", "scheme": "Bearer " },
      "defaultModel": "glm-5.3",
      "supportsTools": true,
      "supportsStreaming": true,
      "docsUrl": "https://docs.z.ai/guides/develop/http/introduction",
      "notes": "Z.ai international endpoint. China endpoint: https://open.bigmodel.cn/api/paas/v4."
    },
    {
      "id": "qwen",
      "name": "Qwen / Alibaba Model Studio",
      "protocol": "openai-chat",
      "baseUrl": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
      "chatPath": "/chat/completions",
      "modelsPath": "/models",
      "auth": { "type": "bearer", "header": "Authorization", "scheme": "Bearer " },
      "defaultModel": "qwen4-max",
      "supportsTools": true,
      "supportsStreaming": true,
      "docsUrl": "https://www.alibabacloud.com/help/en/model-studio/compatibility-of-openai-with-dashscope",
      "notes": "Model Studio now recommends workspace-specific *.maas.aliyuncs.com endpoints. Replace {workspaceId} in the base URL if your account requires it."
    },
    {
      "id": "mistral",
      "name": "Mistral",
      "protocol": "openai-chat",
      "baseUrl": "https://api.mistral.ai/v1",
      "chatPath": "/chat/completions",
      "modelsPath": "/models",
      "auth": { "type": "bearer", "header": "Authorization", "scheme": "Bearer " },
      "defaultModel": "",
      "supportsTools": true,
      "supportsStreaming": true,
      "docsUrl": "https://docs.mistral.ai/api/"
    },
    {
      "id": "xai",
      "name": "xAI",
      "protocol": "openai-chat",
      "baseUrl": "https://api.x.ai/v1",
      "chatPath": "/chat/completions",
      "modelsPath": "/models",
      "auth": { "type": "bearer", "header": "Authorization", "scheme": "Bearer " },
      "defaultModel": "",
      "supportsTools": true,
      "supportsStreaming": true,
      "docsUrl": "https://docs.x.ai/docs/api-reference"
    },
    {
      "id": "groq",
      "name": "Groq",
      "protocol": "openai-chat",
      "baseUrl": "https://api.groq.com/openai/v1",
      "chatPath": "/chat/completions",
      "modelsPath": "/models",
      "auth": { "type": "bearer", "header": "Authorization", "scheme": "Bearer " },
      "defaultModel": "",
      "supportsTools": true,
      "supportsStreaming": true,
      "docsUrl": "https://console.groq.com/docs/api-reference"
    },
    {
      "id": "together",
      "name": "Together",
      "protocol": "openai-chat",
      "baseUrl": "https://api.together.xyz/v1",
      "chatPath": "/chat/completions",
      "modelsPath": "/models",
      "auth": { "type": "bearer", "header": "Authorization", "scheme": "Bearer " },
      "defaultModel": "",
      "supportsTools": true,
      "supportsStreaming": true,
      "docsUrl": "https://docs.together.ai/reference/chat-completions"
    },
    {
      "id": "custom-openai",
      "name": "Custom OpenAI-compatible",
      "protocol": "openai-chat",
      "baseUrl": "https://",
      "chatPath": "/chat/completions",
      "modelsPath": "/models",
      "auth": { "type": "bearer", "header": "Authorization", "scheme": "Bearer " },
      "defaultModel": "",
      "supportsTools": true,
      "supportsStreaming": true,
      "docsUrl": "https://github.com/nullsec/nullsec/blob/main/docs/PROVIDERS.md",
      "notes": "Edit baseUrl, auth, and headers for your endpoint. Never point this at an untrusted server with a reusable key."
    }
  ]
}